OperationType = {
	ADD = 0,
	ADD_BASE = 1,
	MULTIPLY = 2,
	STACKING_MULTIPLY = 3,
	SET = 4,
	SET_BASE = 5,
	SET_MIN = 6,
	SET_MAX = 7
}

coroutine.sleep = function(ms)
	local t = os.millis() + ms
	repeat
		yield()
	until t <= os.millis()
end

return function(f)
	coroutine.yield()
	coroutine.yield = yield
	xpcall(f, function(e)
		if type(e) == "string" and e:sub(-14) == "Stop requested" then
			print(e)
		else
			print(debug.traceback(e,2))
		end
	end)
end

