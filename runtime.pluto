--dummy,R"EOC(--[[OpenWF Script Runtime]]--

Vector3 = require "pluto:vector3"
Rotation = Vector3

class owfClassBase
	function __construct(addr)
		assert(addr ~= nil)
		assert(addr ~= 0)
		rawset(self, "addr", addr)
	end
end

luau_begin_call = luau_stktrk_begin

function luau_end_call(f)
	luau_call(f, luau_stktrk_end())
end

class ObjectType extends owfClassBase
	function GetName()
		luau_begin_call()
		luau_push_pointer(self.addr)
		luau_end_call(luau_find_method("ObjectType", "GetName"))
		return luau_pop_string()
	end

	function GetFullName()
		luau_begin_call()
		luau_push_pointer(self.addr)
		luau_end_call(luau_find_method("ObjectType", "GetFullName"))
		return luau_pop_string()
	end

	function GetParent()
		luau_begin_call()
		luau_push_pointer(self.addr)
		luau_end_call(luau_find_method("ObjectType", "GetParent"))
		if addr := luau_pop_pointer() then
			return new ObjectType(addr)
		end
	end

	function isNameInHierarchy(name)
		local type = self
		repeat
			if type:GetName() == name then
				return true
			end
			type = type:GetParent()
		until not type
		return false
	end
end

class Object extends owfClassBase
	function GetType()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Object", "GetType"))
		if addr := luau_pop_pointer() then
			return new ObjectType(addr)
		end
	end

	function GetName()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Object", "GetName"))
		return luau_pop_string()
	end

	function GetFullName()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Object", "GetFullName"))
		return luau_pop_string()
	end
end

