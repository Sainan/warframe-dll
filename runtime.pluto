class RadialSolarMap extends Object
	function GetRegions()
		luau_push_object(self.addr)
		luau_call(luau_find_method("RadialSolarMap", "GetRegions"), 1)
		local t = {}
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				t:insert(new RadialRegion())
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
		return t
	end
end

class RadialRegion
	function __construct()
		luau_push_value(-1)
		luau_call(luau_find_getter("RadialRegion", "name"), 1)
		self.name = luau_pop_string()

		self.sectors = {}
		luau_call(luau_find_getter("RadialRegion", "sectors"), 1)
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				self.sectors:insert(new RadialSector(luau_pop_pointer()))
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
	end
end

class RadialSector extends owfClassBase
	function __newindex(name, value)
		if RadialSector[name] then
			return rawset(self, name, value)
		end
		switch name do
			case "unlocked":
				luau_push_pointer(self.addr)
				luau_push_bool(value)
				luau_call(luau_find_setter("RadialSector", "unlocked"), 2)
				return
		end
		error("Unknown field: "..name)
	end

	function __index(name)
		if RadialSector[name] then
			return rawget(self, name)
		end
		switch name do
			case "name":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("RadialSector", "name"), 1)
				luau_call(luau_find_method("Symbol", "__tostring"), 1)
				return new Symbol(luau_pop_string())

			case "unlocked":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("RadialSector", "unlocked"), 1)
				return luau_pop_bool()

			case "nodeType":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("RadialSector", "nodeType"), 1)
				return math.tointeger(luau_pop_number())

			case "missionTag":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("RadialSector", "missionTag"), 1)
				luau_call(luau_find_method("Symbol", "__tostring"), 1)
				return new Symbol(luau_pop_string())

			case "mission":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("RadialSector", "mission"), 1)
				return new LotusMissionInfo(luau_pop_pointer())
		end
		error("Unknown field: "..name)
	end
end
RadialSector.__parent = nil -- Hack so our __index is used

class LotusMissionInfo extends owfClassBase
	function __index(name)
		if RadialSector[name] then
			return RadialSector[name]
		end
		switch name do
			case "missionType":
			case "minEnemyLevel":
			case "maxEnemyLevel":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("LotusMissionInfo", name), 1)
				return math.tointeger(luau_pop_number())

			case "goalTag":
			case "activeMissionTag":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("LotusMissionInfo", name), 1)
				luau_call(luau_find_method("Symbol", "__tostring"), 1)
				return new Symbol(luau_pop_string())

			case "levelOverride":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("LotusMissionInfo", "levelOverride"), 1)
				if addr := luau_pop_pointer() then 
					return new ObjectType(addr)
				end
				luau_pop(1)
				return nil
		end
		error("Unknown field: "..name)
	end
end
LotusMissionInfo.__parent = nil -- Hack so our __index is used

class StoreManifest extends Object
	function GetStoreItemsOfType(weakResource)
		luau_push_object(self.addr)
		do
			luau_push_string(weakResource)
			luau_call(mem_read_i64(mem_scan_exe("56 A9 D0 7E 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("StoreManifest", "GetStoreItemsOfType"), 2)
		local t = {}
		local i = 1
		while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
			t:insert(new StoreItem(luau_pop_object()))
			++i
		end
		luau_pop(2)
		return t
	end
end

class StoreItem extends Object
	function GetProductCategory()
		luau_push_object(self.addr)
		luau_call(luau_find_method("StoreItem", "GetProductCategory"), 1)
		return math.tointeger(luau_pop_number())
	end

	function ExcludeFromCodex()
		luau_push_object(self.addr)
		luau_call(luau_find_method("StoreItem", "ExcludeFromCodex"), 1)
		return luau_pop_bool()
	end

	function ShowInMarket()
		luau_push_object(self.addr)
		luau_call(luau_find_method("StoreItem", "ShowInMarket"), 1)
		return luau_pop_bool()
	end
end

class MotionControllerBase extends Object
	function GetSpeedMultiplier()
		luau_push_object(self.addr)
		luau_call(luau_find_method("MotionControllerBase", "GetSpeedMultiplier"), 1)
		return luau_pop_number()
	end

	function SetSpeedMultiplier(f)
		luau_push_object(self.addr)
		luau_push_float(f)
		luau_call(luau_find_method("MotionControllerBase", "SetSpeedMultiplier"), 2)
