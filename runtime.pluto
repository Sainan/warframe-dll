class EngineNpcMgr extends Object end
class NpcManager extends EngineNpcMgr
	function PauseAllAgents()
		luau_push_object(self.addr)
		luau_call(luau_find_method("NpcManager", "PauseAllAgents"), 1)
	end

	function CreateAgentAtPosition(type, pos, rot, optionalSymbol, optionalLevel)
		if avatar := gRegion:GetLocalPlayerAvatar() then
			luau_push_object(self.addr)
			do
				luau_push_string(type)
				luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetPosition"), 1)
				local ud = luau_get_userdata()
				mem_write_f32(ud + 0x20, pos.x)
				mem_write_f32(ud + 0x24, pos.y)
				mem_write_f32(ud + 0x28, pos.z)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetRotation"), 1)
				local ud = luau_get_userdata()
				mem_write_f32(ud + 0x20, rot.x)
				mem_write_f32(ud + 0x24, rot.y)
				mem_write_f32(ud + 0x28, rot.z)
			end
			if optionalSymbol then
				luau_push_string(optionalSymbol.name)
				luau_call(luau_find_ctor("Symbol"), 1)
			else
				luau_call(luau_find_ctor("Symbol"), 0)
			end
			luau_push_int(optionalLevel or 0)
			luau_pop(luau_call(luau_find_method("NpcManager", "CreateAgentAtPosition"), 6))
		end
	end
end

class HudStatus extends Object end
class LotusHudStatus extends HudStatus
	function GetFlashMarkers()
		luau_push_object(self.addr)
		luau_call(luau_find_method("LotusHudStatus", "GetFlashMarkers"), 1)
		local t = {}
		local i = 1
		while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
			t:insert(new FlashMarker(luau_pop_object()))
			++i
		end
		luau_pop(2)
		return t
	end
end

class FlashMarker extends owfClassBase
	function ScreenX()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenX"), 1)
		return luau_pop_number()
	end

	function ScreenY()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenY"), 1)
		return luau_pop_number()
	end

	function ScreenZ()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenZ"), 1)
		return luau_pop_number()
	end

	function __index(name)
		if FlashMarker[name] then
			return FlashMarker[name]
		end
		switch name do
			case "garbage":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return luau_pop_bool()

			case "markerType":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return math.tointeger(luau_pop_number())

			case "distanceToEye":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return luau_pop_number()

			case "pos":
				do
					luau_push_pointer(self.addr)
					luau_call(luau_find_getter("FlashMarker", name), 1)
					local addr = mem_read_i64(luau_pop_userdata() + 0x18)
					return new Vector3(mem_read_f32(addr + 0x18), mem_read_f32(addr + 0x10), mem_read_f32(addr + 0x14))
				end
				break

			case "baseMarkerInfo":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", "baseMarkerInfo"), 1)
				return new BaseMarkerInfo(luau_pop_object())
		end
		error("Unknown field: "..name)
	end
end
FlashMarker.__parent = nil -- Hack so our __index is used

class BaseMarkerInfo extends Entity
	function SetMarkerType(i)
		luau_push_object(self.addr)
		luau_push_int(i)
		luau_call(luau_find_method("BaseMarkerInfo", "SetMarkerType"), 2)
	end

	function SetDisplayRange(range)
		luau_push_object(self.addr)
		do
			luau_push_float(range.min)
			luau_push_float(range.max)
			luau_call(luau_find_ctor("Range"), 2)
		end
		luau_call(luau_find_method("BaseMarkerInfo", "SetDisplayRange"), 2)
	end
end

Engine = {}

class Engine.OpenLevelArgs
	private level
	private gamerules

	function SetLevel(level)
		self.level = level
	end

	function SetGameRules(gamerules)
		self.gamerules = gamerules
	end

	function pushToLuau()
		luau_call(luau_find_ctor("OpenLevelArgs"), 0)

		luau_push_value(-1)
		luau_push_string(self.level)
		luau_call(luau_find_method("OpenLevelArgs", "SetLevel"), 2)

		if self.gamerules then
			luau_push_value(-1)
			luau_push_string(self.gamerules)
			luau_call(luau_find_method("OpenLevelArgs", "SetGameRules"), 2)
		end
	end
end
setmetatable(Engine.OpenLevelArgs, { __call = || -> new Engine.OpenLevelArgs() })

class Symbol
	function __construct(public name = "")
	end

	function __eq(b)
		return self.name == b.name
	end

	function __tostring()
		return self.name
	end
end
setmetatable(Symbol, { __call = |_, name| -> new Symbol(name) })

function IsNull(val)
	return not val
end

function Type(name)
	return name
end

Sleep = coroutine.sleep

function Resource(name)
	return name
end

function WeakResource(name)
	return name
end

function Range(min, max)
	return { min = min, max = max }
end

function Engine.OpenLevel(args)
	args:pushToLuau()
	luau_call(mem_read_i64(mem_scan_exe("FC 1D 0A 4E 00 00 00 00") + 8), 1)
end

-- compatibility with older versions of OpenWF that had these incorrectly scoped
OpenLevelArgs = Engine.OpenLevelArgs
OpenLevel = Engine.OpenLevel

gRegion = {
	function GetLocalPlayer()
		if player := get_local_player() then
			return new HumanPlayer(player)
		end
	end,
	function GetLocalPlayerAvatar()
		if player := get_local_player() then
			if avatar := player_get_avatar(player) then
				return new LotusAvatar(avatar)
			end
		end
	end,
	function GetGameCamera()
		if camera := get_game_camera() then
			return new Entity(camera)
		end
	end,
	function GetGameRules()
		local obj = new Object(get_gamerules())
		local type = obj:GetType()
		if type:isNameInHierarchy("LotusAttractModeGameRules") then
			return new LotusAttractModeGameRules(obj.addr)
		end
		if type:isNameInHierarchy("LotusGameRules") then
			return new LotusGameRules(obj.addr)
		end
		if type:isNameInHierarchy("GameRulesImpl") then
			return new GameRulesImpl(obj.addr)
		end
		return obj
	end,
	function GetAvatars()
		luau_push_object(get_regionmgr())
		luau_call(luau_find_method("RegionMgrImpl", "GetAvatars"), 1)
		local t = {}
		local i = 1
		while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
			t:insert(new LotusAvatar(luau_pop_object()))
			++i
		end
		luau_pop(2)
		return t
	end,
	function FindFirstTagged(symbol)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(symbol.name)
			luau_call(luau_find_ctor("Symbol"), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "FindFirstTagged"), 2)
		if obj := luau_pop_object() then
			return new LotusAvatar(obj)
		else
			luau_pop(1)
		end
	end,
	function FindTagged(symbol)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(symbol.name)
			luau_call(luau_find_ctor("Symbol"), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "FindTagged"), 2)
		local t = {}
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				t:insert(new LotusAvatar(luau_pop_object()))
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
		return t
	end,
	function FindAll(type)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "FindAll"), 2)
		local t = {}
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				t:insert(new LotusAvatar(luau_pop_object()))
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
		return t
	end,
	function CreateObject(type)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "CreateObject"), 2)
		return new Object(luau_pop_object())
	end,
	function CreateEntity(type, pos, rot)
		if avatar := gRegion:GetLocalPlayerAvatar() then
			luau_push_object(get_regionmgr())
			do
				luau_push_string(type)
				luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetPosition"), 1)
				if pos then -- optional for compatibility with older OpenWF versions
					local ud = luau_get_userdata()
					mem_write_f32(ud + 0x20, pos.x)
					mem_write_f32(ud + 0x24, pos.y)
					mem_write_f32(ud + 0x28, pos.z)
				end
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetRotation"), 1)
				if rot then -- optional for compatibility with older OpenWF versions
					local ud = luau_get_userdata()
					mem_write_f32(ud + 0x20, rot.x)
					mem_write_f32(ud + 0x24, rot.y)
					mem_write_f32(ud + 0x28, rot.z)
				end
			end
			luau_call(luau_find_method("RegionMgrImpl", "CreateEntity"), 4)
			return pop_entity()
		end
	end,
	function GetNpcMgr()
		luau_push_object(get_regionmgr())
		luau_call(luau_find_method("RegionMgrImpl", "GetNpcMgr"), 1)
		return new NpcManager(luau_pop_object())
	end,
}

setmetatable(_G, {
	function __index(name)
		if name == "gGameRules" then
			return gRegion:GetGameRules()
		end
		if name == "gStarChart" then
			local gr = gRegion:GetGameRules()
			if gr instanceof LotusAttractModeGameRules then
				return gr:GetStarChart()
			end
			return gr:GetCurrentStarChart()
		end
		return rawget(self, name)
	end
})

