end

class InputControllerBase extends Object end

class InputController extends InputControllerBase
	function SetStopMovement(b)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_bool(b)
		luau_end_call(luau_find_method("InputController", "SetStopMovement"))
	end
end

class LotusGameRules extends Object
	function OpenMissionContinueDialog()
		luau_begin_call()
		luau_push_object(get_gamerules())
		luau_push_nil()
		luau_end_call(luau_find_method("LotusGameRules", "OpenMissionContinueDialog"))
	end
end

function Type(name)
	return name
end

gRegion = {
	function GetLocalPlayer()
		if player := get_local_player() then
			return new HumanPlayer(player)
		end
	end,
	function GetLocalPlayerAvatar()
		if player := get_local_player() then
			if avatar := player_get_avatar(player) then
				return new LotusAvatar(avatar)
			end
		end
	end,
	function GetGameCamera()
		if camera := get_game_camera() then
			return new Entity(camera)
		end
	end,
	function GetGameRules()
		local obj = new Object(get_gamerules())
		if obj:GetFullName() == "LotusGameRules" then
			return new LotusGameRules(obj.addr)
		end
		return obj
	end,
	function GetAvatars()
		luau_begin_call()
		luau_push_object(get_regionmgr())
		luau_end_call(luau_find_method("RegionMgrImpl", "GetAvatars"))
		local t = {}
		local i = 1
		while ud := luau_get_table_userdata(1, i) do
			t:insert(new LotusAvatar(mem_read_i64(mem_read_i64(mem_read_i64(ud + 0x18)))))
			++i
		end
		return t
	end,
}

setmetatable(_G, {
	function __index(name)
		if name == "gGameRules" then
			return gRegion:GetGameRules()
		end
		return rawget(self, name)
	end
})

Engine = {
	SLOT_1 = 0,
	SLOT_2 = 1,
	SLOT_3 = 2,
	SLOT_4 = 3,
	SLOT_5 = 4,
	SLOT_6 = 5,
	SLOT_7 = 6,
	SLOT_8 = 7,
	SLOT_9 = 8,
	SLOT_10 = 9,
	SLOT_11 = 10,
	SLOT_12 = 11,
	SLOT_13 = 12,
	SLOT_14 = 13,
	INVALID = 14,
}

return function(f)
	coroutine.yield()
	coroutine.yield = yield
	xpcall(|| -> f(), function(e)
		if e:sub(-14) == "Stop requested" then
			print(e)
		else
			print(debug.traceback(e,2))
		end
	end)
end

