class BaseEntity extends Object end

class Entity extends BaseEntity
	function GetPosition()
		return new Vector3(entity_get_pos(self.addr))
	end

	function SetPosition(pos)
		entity_set_pos(self.addr, pos.x, pos.y, pos.z)
	end

	function GetRotation()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Entity", "GetRotation"))
		local ud = luau_pop_userdata()
		return new Rotation(mem_read_f32(ud + 0x10), mem_read_f32(ud + 0x14), mem_read_f32(ud + 0x18))
	end

	function GetHealth()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Entity", "GetHealth"))
		return luau_pop_number()
	end

	function SetHealth(health)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_int(health)
		luau_end_call(luau_find_method("Entity", "SetHealth"))
	end

	function GetDrawOnTop()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Entity", "GetDrawOnTop"))
		return luau_pop_bool()
	end

	function SetDrawOnTop(b)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_bool(b)
		luau_end_call(luau_find_method("Entity", "SetDrawOnTop"))
	end

	function GetMeshScale()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("Entity", "GetMeshScale"))
		return luau_pop_number()
	end

	function SetMeshScale(f)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_float(f)
		luau_end_call(luau_find_method("Entity", "SetMeshScale"))
	end
end

class BaseAvatar extends Entity
	function GetMaxHealth(b = true)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_bool(b)
		luau_end_call(luau_find_method("BaseAvatar", "GetMaxHealth"))
		return luau_pop_number()
	end

	function SetMaxHealth(health, b = false)
		luau_begin_call()
		luau_push_object(self.addr)
		luau_push_int(health)
		luau_push_bool(b)
		luau_end_call(luau_find_method("BaseAvatar", "SetMaxHealth"))
	end

	function Suicide()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("BaseAvatar", "Suicide"))
	end

	function DamageControl()
		if addr := baseavatar_get_damage_controller(self.addr) then
			return new DamageControllerBase(addr)
		end
	end

	function InventoryControl()
		if addr := baseavatar_get_inventory_controller(self.addr) then
			local inventory = new LotusInventoryController(addr)
			if not "NullInventoryController" in inventory:GetFullName() then
				return new LotusInventoryController(addr)
			end
		end
	end

	function InputControl()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("BaseAvatar", "InputControl"))
		if addr := luau_pop_object() do
			return new InputController(addr)
		end
	end

	function GiveItem(type, b)
		luau_push_object(self.addr)
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_push_bool(b)
		luau_pop(luau_call(luau_find_method("BaseAvatar", "GiveItem"), 3))
	end

	function MotionControl()
		luau_begin_call()
		luau_push_object(self.addr)
		luau_end_call(luau_find_method("BaseAvatar", "MotionControl"))
		if addr := luau_pop_object() do
			return new MotionControllerBase(addr)
		end
	end
end

