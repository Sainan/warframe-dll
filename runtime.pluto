class WeaponImpactBehavior extends Object
	function __index(name)
		if Object[name] then
			return Object[name]
		end
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				luau_begin_call()
				luau_push_object(self.addr)
				luau_end_call(luau_find_getter("WeaponImpactBehavior", name))
				return luau_pop_number()
		end
	end

	function __newindex(name, value)
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				luau_begin_call()
				luau_push_object(self.addr)
				luau_push_float(value)
				luau_end_call(luau_find_setter("WeaponImpactBehavior", name))
		end
	end
end
WeaponImpactBehavior.__parent = nil -- Hack so our __index is used

