coroutine.sleep = function(ms)
	local t = os.millis() + ms
	repeat
		yield()
	until t <= os.millis()
end

return function(f)
	coroutine.yield()
	coroutine.yield = yield
	xpcall(|| -> f(), function(e)
		if e:sub(-14) == "Stop requested" then
			print(e)
		else
			print(debug.traceback(e,2))
		end
	end)
end

