UISys = {}

class UISys.ScriptResLoader extends owfUserdata
	__name = "UISys.ScriptResLoader"

	function IsDone()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ScriptResLoader", "IsDone"), 1)
		return ivkr_pop_bool()
	end

	function SpotLoad()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ScriptResLoader", "SpotLoad"), 1)
	end

	function Abort()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ScriptResLoader", "Abort"), 1)
	end
end

function IsNull(val)
	if val instanceof owfUserdata then
		val:pushToIvkr()
		ivkr_call(mem_read_i64(mem_scan_exe("33 82 99 7B 00 00 00 00") + 8), 1)
		return ivkr_pop_bool()
	end
	return not val
end

function Type(name)
	return name
end

function Resource(name)
	return name
end

function WeakResource(name)
	ivkr_push_string(name)
	ivkr_call(mem_read_i64(mem_scan_exe("56 A9 D0 7E 00 00 00 00") + 8), 1)
	return new ObjectType()
end

function Range(minValue, maxValue)
	return { minValue = minValue, maxValue = maxValue }
end

function ivkr_pop_range()
	ivkr_push_value(-1)
	ivkr_call(ivkr_find_getter("Range", "minValue"), 1)
	local minValue = ivkr_pop_number()
	ivkr_call(ivkr_find_getter("Range", "maxValue"), 1)
	local maxValue = ivkr_pop_number()
	return Range(minValue, maxValue)
end

function Localize(loctag, subs = {})
	ivkr_push_string(loctag)
	ivkr_newtable()
	for k, v in subs do
		ivkr_push_string(k)
		ivkr_push_string(v)
		ivkr_settable(-3)
	end
	ivkr_call(mem_read_i64(mem_scan_exe("AD 36 36 60 00 00 00 00") + 8), 2)
	return ivkr_pop_string()
end

function Engine.OpenLevel(args)
	args:pushToIvkr()
	ivkr_call(mem_read_i64(mem_scan_exe("FC 1D 0A 4E 00 00 00 00") + 8), 1)
end

function UISys.ScriptResLoader_Create(names)
	ivkr_newtable()
	for k, v in ipairs(names) do
		ivkr_push_int(k)
		ivkr_push_string(v)
		ivkr_settable(-3)
	end
	ivkr_call(mem_read_i64(mem_scan_exe("A3 5D 64 42 00 00 00 00") + 8), 1)
	return new UISys.ScriptResLoader()
end

function AngleToDirection(rot)
	ivkr_push_rotation(rot)
	ivkr_call(mem_read_i64(mem_scan_exe("05 E5 C6 F6 00 00 00 00") + 8), 1)
	local ud = ivkr_pop_userdata()
	return new Vector(mem_read_f32(ud + 0x20), mem_read_f32(ud + 0x24), mem_read_f32(ud + 0x28))
end

gRegion = {
	function GetLocalPlayer()
		if player := get_local_player() then
			ivkr_push_object(player)
			return new HumanPlayer()
		end
	end,
	function GetLocalPlayerAvatar()
		if player := get_local_player() then
			if avatar := player_get_avatar(player) then
				ivkr_push_object(avatar)
				return ivkr_pop_entity()
			end
		end
	end,
	function GetGameCamera()
		if camera := get_game_camera() then
			ivkr_push_object(camera)
			return new Entity()
		end
	end,
	function GetGameRules()
		ivkr_push_object(get_gamerules())
		ivkr_push_object(get_gamerules())
		ivkr_call(ivkr_find_method("Object", "GetType"), 1)
		local type = new ObjectType()
		if type:isNameInHierarchy("LotusAttractModeGameRules") then
			return new LotusAttractModeGameRules()
		end
		if type:isNameInHierarchy("LotusHubGameRules") then
			return new LotusHubGameRules()
		end
		if type:isNameInHierarchy("LotusGameRules") then
			return new LotusGameRules()
		end
		if type:isNameInHierarchy("GameRulesImpl") then
			return new GameRulesImpl()
		end
		return new Object()
	end,
	function GetAvatars()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetAvatars"), 1)
		local t = {}
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(new LotusAvatar())
			++i
		end
		ivkr_pop(2)
		return t
	end,
	function FindFirstTagged(symbol)
		ivkr_push_object(get_regionmgr())
		symbol:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindFirstTagged"), 2)
		if ivkr_type(-1) > 0 do
			return ivkr_pop_entity()
		else
			ivkr_pop(1)
		end
	end,
	function FindTagged(symbol)
		ivkr_push_object(get_regionmgr())
		symbol:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindTagged"), 2)
		return ivkr_pop_entity_array()
	end,
	function FindAll(type)
		ivkr_push_object(get_regionmgr())
		do
			ivkr_push_string(type)
			ivkr_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindAll"), 2)
		return ivkr_pop_entity_array()
	end,
	function CreateObject(type)
		ivkr_push_object(get_regionmgr())
		do
			ivkr_push_string(type)
			ivkr_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		ivkr_call(ivkr_find_method("RegionMgrImpl", "CreateObject"), 2)
		return new Object()
	end,
	function CreateEntity(type, pos, rot)
		if avatar := gRegion:GetLocalPlayerAvatar() then
			ivkr_push_object(get_regionmgr())
			do
				ivkr_push_string(type)
				ivkr_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
			end
			do
				avatar:pushToIvkr()
				ivkr_call(ivkr_find_method("Entity", "GetPosition"), 1)
				if pos then -- optional for compatibility with older OpenWF versions
					local ud = ivkr_get_userdata()
					mem_write_f32(ud + 0x20, pos.x)
					mem_write_f32(ud + 0x24, pos.y)
					mem_write_f32(ud + 0x28, pos.z)
				end
			end
			do
				avatar:pushToIvkr()
				ivkr_call(ivkr_find_method("Entity", "GetRotation"), 1)
				if rot then -- optional for compatibility with older OpenWF versions
					local ud = ivkr_get_userdata()
					mem_write_f32(ud + 0x20, rot.heading)
					mem_write_f32(ud + 0x24, rot.pitch)
					mem_write_f32(ud + 0x28, rot.bank)
				end
			end
			ivkr_call(ivkr_find_method("RegionMgrImpl", "CreateEntity"), 4)
			return ivkr_pop_entity()
		end
	end,
	function GetNpcMgr()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetNpcMgr"), 1)
		return new NpcManager()
	end,
	function Raycast(fromPos, toPos, avatar, _, outPos)
		ivkr_call(ivkr_find_ctor("Vector"), 0)

		ivkr_push_object(get_regionmgr())
		ivkr_push_vector(fromPos)
		ivkr_push_vector(toPos)
		avatar:pushToIvkr()
		ivkr_push_nil()
		ivkr_push_value(-6)
		ivkr_call(ivkr_find_method("RegionMgrImpl", "Raycast"), 6)

		local ok = ivkr_type(-1) > 0
		ivkr_pop(1)

		local ud = ivkr_pop_userdata()
		outPos.x = mem_read_f32(ud + 0x20)
		outPos.y = mem_read_f32(ud + 0x24)
		outPos.z = mem_read_f32(ud + 0x28)

		return ok
	end,
}

setmetatable(_G, {
	function __index(name)
		if name == "gGameRules" then
			return gRegion:GetGameRules()
		end
		if name == "gStarChart" then
			local gr = gRegion:GetGameRules()
			if gr instanceof LotusAttractModeGameRules then
				return gr:GetStarChart()
			end
			return gr:GetCurrentStarChart()
		end
		return rawget(self, name)
	end
})

