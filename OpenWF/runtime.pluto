local { http, json, scheduler, url, vector3 } = require "*"

Vector = vector3
Vector3 = vector3 -- compatibility

function ivkr_push_vector(vec)
	ivkr_push_float(vec.x)
	ivkr_push_float(vec.y)
	ivkr_push_float(vec.z)
	ivkr_call(ivkr_find_ctor("Vector"), 3)
end

class Rotation
	function __construct(public heading = 0, public pitch = 0, public bank = 0)
	end

	function __tostring()
		return $"Rotation({self.heading}, {self.pitch}, {self.bank})"
	end
end
setmetatable(Rotation, { __call = |_, ...| -> new Rotation(...) })

function ivkr_push_rotation(rot)
	ivkr_push_float(rot.heading)
	ivkr_push_float(rot.pitch)
	ivkr_push_float(rot.bank)
	ivkr_call(ivkr_find_ctor("Rotation"), 3)
end

class Symbol
	__name = "Symbol"

	function __construct(public name = "")
	end

	function __eq(b)
		return self.name == b.name
	end

	function __tostring()
		return self.name
	end

	function c_str()
		return self.name
	end

	function pushToIvkr()
		ivkr_push_string(self.name)
		ivkr_call(ivkr_find_ctor("Symbol"), 1)
	end
end
setmetatable(Symbol, { __call = |_, name| -> new Symbol(name) })

class Color
	__name = "Color"

	function __construct(public red, public green, public blue, public alpha = 255)
	end

	function __tostring()
		return $"Color({self.red}, {self.green}, {self.blue}, {self.alpha})"
	end

	function pushToIvkr()
		ivkr_push_int(self.red)
		ivkr_push_int(self.green)
		ivkr_push_int(self.blue)
		ivkr_push_int(self.alpha)
		ivkr_call(ivkr_find_ctor("Color"), 4)
	end

	function GetUInt()
		return (self.red << 16) | (self.green << 8) | self.blue
	end
end
setmetatable(Color, { __call = |_, ...| -> new Color(...) })

function ivkr_pop_color()
	ivkr_push_value(-1)
	ivkr_call(ivkr_find_getter("Color", "red"), 1)
	local red = math.tointeger(ivkr_pop_number())
	ivkr_push_value(-1)
	ivkr_call(ivkr_find_getter("Color", "green"), 1)
	local green = math.tointeger(ivkr_pop_number())
	ivkr_push_value(-1)
	ivkr_call(ivkr_find_getter("Color", "blue"), 1)
	local blue = math.tointeger(ivkr_pop_number())
	ivkr_call(ivkr_find_getter("Color", "alpha"), 1)
	local alpha = math.tointeger(ivkr_pop_number())
	return new Color(red, green, blue, alpha)
end

class owfUserdata
	function __construct()
		if not ivkr_isuserdata(-1) then
			error($"attempt to construct {self.__name} from nil")
		end
		ivkr_push_string(tostring(self))
		ivkr_push_value(-2)
		ivkr_settable(-10002)
		ivkr_pop(1)
	end

	function __gc()
		ivkr_push_string(tostring(self))
		ivkr_push_nil()
		ivkr_settable(-10002)
	end

	function pushToIvkr()
		ivkr_push_string(tostring(self))
		ivkr_gettable(-10002)
	end
end

function ivkr_pop_array(mt)
	local t = {}
	if ivkr_istable(-1) then
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(new mt())
			++i
		end
		ivkr_pop(2)
	else
		ivkr_pop(1)
	end
	return t
end

class ObjectType extends owfUserdata
	__name = "ObjectType"

	function __eq(other)
		return self:GetFullName() == other:GetFullName()
	end

	function GetName()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ObjectType", "GetName"), 1)
		return ivkr_pop_string()
	end

	function GetFullName()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ObjectType", "GetFullName"), 1)
		return ivkr_pop_string()
	end

	function GetParent()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("ObjectType", "GetParent"), 1)
		if ivkr_type(-1) > 0 then
			return new ObjectType()
		else
			ivkr_pop(1)
		end
	end

	-- used to be documented, but trying to get rid of this as non-full names are not necessarily unique
	function isNameInHierarchy(name)
		local type = self
		repeat
			if type:GetName() == name then
				return true
			end
			type = type:GetParent()
		until not type
		return false
	end

	function getHierarchy()
		local hier = {}
		local type = self
		repeat
			hier:insert(type:GetFullName())
			type = type:GetParent()
		until not type
		return hier
	end
end

class Object extends owfUserdata
	__name = "Object"

	function __eq(other)
		self:pushToIvkr()
		if addr := ivkr_pop_object() then
			other:pushToIvkr()
			return addr == ivkr_pop_object()
		end
		return false
	end

	function GetType()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Object", "GetType"), 1)
		if ivkr_type(-1) > 0 then
			return new ObjectType()
		else
			ivkr_pop(1)
		end
	end

	function GetName()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Object", "GetName"), 1)
		return ivkr_pop_string()
	end

	function GetFullName()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Object", "GetFullName"), 1)
		return ivkr_pop_string()
	end

	function IsA(type)
		local htype = self:GetType()
		repeat
			if htype:GetFullName() == type then
				return true
			end
			htype = htype:GetParent()
		until not htype
		return false
	end
end

