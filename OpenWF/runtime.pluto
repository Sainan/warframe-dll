class HudStatus extends Object
	__name = "HudStatus"

end
class LotusHudStatus extends HudStatus
	__name = "LotusHudStatus"

	function GetFlashMarkers()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("LotusHudStatus", "GetFlashMarkers"), 1)
		local t = {}
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(new FlashMarker())
			++i
		end
		ivkr_pop(2)
		return t
	end
end

class FlashMarker extends owfUserdata
	__name = "FlashMarker"

	function ScreenX()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("FlashMarker", "ScreenX"), 1)
		return ivkr_pop_number()
	end

	function ScreenY()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("FlashMarker", "ScreenY"), 1)
		return ivkr_pop_number()
	end

	function ScreenZ()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("FlashMarker", "ScreenZ"), 1)
		return ivkr_pop_number()
	end

	function __index(name)
		if FlashMarker[name] then
			return FlashMarker[name]
		end
		switch name do
			case "garbage":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("FlashMarker", name), 1)
				return ivkr_pop_bool()

			case "markerType":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("FlashMarker", name), 1)
				return math.tointeger(ivkr_pop_number())

			case "distanceToEye":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("FlashMarker", name), 1)
				return ivkr_pop_number()

			case "pos":
				do
					self:pushToIvkr()
					ivkr_call(ivkr_find_getter("FlashMarker", name), 1)
					local addr = mem_read_i64(ivkr_pop_userdata() + 0x18)
					return new Vector(mem_read_f32(addr + 0x18), mem_read_f32(addr + 0x10), mem_read_f32(addr + 0x14))
				end
				break

			case "baseMarkerInfo":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("FlashMarker", "baseMarkerInfo"), 1)
				return new BaseMarkerInfo()
		end
		error("Unknown field: "..name)
	end
end

class BaseMarkerInfo extends Entity
	__name = "BaseMarkerInfo"

