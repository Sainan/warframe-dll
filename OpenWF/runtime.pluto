class CameraControllerBase extends Object
	__name = "CameraControllerBase"

	function implGetVector(funcName)
		luau_push_object(self.addr)
		luau_call(luau_find_method("CameraControllerBase", funcName), 1)
		local ud = luau_pop_userdata()
		return new Vector(mem_read_f32(ud + 0x20), mem_read_f32(ud + 0x24), mem_read_f32(ud + 0x28))
	end

	function implSetVector(funcName, vec)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("CameraControllerBase", "GetViewOffset"), 1)
			local ud = luau_get_userdata()
			mem_write_f32(ud + 0x20, vec.x)
			mem_write_f32(ud + 0x24, vec.y)
			mem_write_f32(ud + 0x28, vec.z)
		end
		luau_call(luau_find_method("CameraControllerBase", funcName), 2)
	end

	function GetViewOffset()
		return self:implGetVector("GetViewOffset")
	end

	function SetViewOffset(vec)
		return self:implSetVector("SetViewOffset", vec)
	end

	function GetAimViewOffset()
		return self:implGetVector("GetAimViewOffset")
	end

	function SetAimViewOffset(vec)
		return self:implSetVector("SetAimViewOffset", vec)
	end

	function GetRunViewOffset()
		return self:implGetVector("GetRunViewOffset")
	end

	function SetRunViewOffset(vec)
		return self:implSetVector("SetRunViewOffset", vec)
	end

	function GetDodgeOffset()
		return self:implGetVector("GetDodgeOffset")
	end

	function SetDodgeOffset(vec)
		return self:implSetVector("SetDodgeOffset", vec)
	end

	function GetInAirViewOffset()
		return self:implGetVector("GetInAirViewOffset")
	end

	function SetInAirViewOffset(vec)
		return self:implSetVector("SetInAirViewOffset", vec)
	end

	function SetInAirAimViewOffset(vec)
		return self:implSetVector("SetInAirAimViewOffset", vec)
	end

	function SetMeleeOffset(vec)
		return self:implSetVector("SetMeleeOffset", vec)
	end

	function SetCoverLeftViewOffset(vec)
		return self:implSetVector("SetCoverLeftViewOffset", vec)
	end

	function SetCoverRightViewOffset(vec)
		return self:implSetVector("SetCoverRightViewOffset", vec)
	end

	function SetCrouchCoverAimLeftViewOffset(vec)
		return self:implSetVector("SetCrouchCoverAimLeftViewOffset", vec)
	end

	function SetCrouchCoverAimRightViewOffset(vec)
		return self:implSetVector("SetCrouchCoverAimRightViewOffset", vec)
	end

	function SetWallRunLeftViewOffset(vec)
		return self:implSetVector("SetWallRunLeftViewOffset", vec)
	end

	function SetWallRunRightViewOffset(vec)
		return self:implSetVector("SetWallRunRightViewOffset", vec)
