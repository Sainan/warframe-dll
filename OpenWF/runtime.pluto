Vector = require "pluto:vector3"
Vector3 = Vector
Rotation = Vector

class owfClassBase
	__name = "owfClassBase"

	function __construct(addr)
		assert(addr ~= nil)
		assert(addr ~= 0)
		rawset(self, "addr", addr)
	end
end

class ObjectType extends owfClassBase
	__name = "ObjectType"

	function GetName()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("ObjectType", "GetName"), 1)
		return luau_pop_string()
	end

	function GetFullName()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("ObjectType", "GetFullName"), 1)
		return luau_pop_string()
	end

	function GetParent()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("ObjectType", "GetParent"), 1)
		if addr := luau_pop_pointer() then
			return new ObjectType(addr)
		else
			luau_pop(1)
		end
	end

	function isNameInHierarchy(name)
		local type = self
		repeat
			if type:GetName() == name then
				return true
			end
			type = type:GetParent()
		until not type
		return false
	end

	function getHierarchy()
		local hier = {}
		local type = self
		repeat
			hier:insert(type:GetFullName())
			type = type:GetParent()
		until not type
		return hier
	end
end

class Object extends owfClassBase
	__name = "Object"

	function GetType()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Object", "GetType"), 1)
		if addr := luau_pop_pointer() then
			return new ObjectType(addr)
		end
	end

	function GetName()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Object", "GetName"), 1)
		return luau_pop_string()
	end

	function GetFullName()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Object", "GetFullName"), 1)
		return luau_pop_string()
	end

	function IsA(type)
		local htype = self:GetType()
		repeat
			if htype:GetFullName() == type then
				return true
			end
			htype = htype:GetParent()
		until not htype
		return false
	end
end

