class EngineNpcMgr extends Object
	__name = "EngineNpcMgr"

end
class NpcManager extends EngineNpcMgr
	__name = "NpcManager"

	function PauseAllAgents()
		luau_push_object(self.addr)
		luau_call(luau_find_method("NpcManager", "PauseAllAgents"), 1)
	end

	function CreateAgentAtPosition(type, pos, rot, optionalSymbol, optionalLevel)
		if avatar := gRegion:GetLocalPlayerAvatar() then
			luau_push_object(self.addr)
			do
				luau_push_string(type)
				luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetPosition"), 1)
				local ud = luau_get_userdata()
				mem_write_f32(ud + 0x20, pos.x)
				mem_write_f32(ud + 0x24, pos.y)
				mem_write_f32(ud + 0x28, pos.z)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetRotation"), 1)
				local ud = luau_get_userdata()
				mem_write_f32(ud + 0x20, rot.x)
				mem_write_f32(ud + 0x24, rot.y)
				mem_write_f32(ud + 0x28, rot.z)
			end
			(optionalSymbol or EMPTY_SYMBOL):pushToLuau()
			luau_push_int(optionalLevel or 0)
			luau_call(luau_find_method("NpcManager", "CreateAgentAtPosition"), 6)
			return new EngineNpcAgent(luau_pop_object())
		end
	end
end

