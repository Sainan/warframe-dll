local AddHudTracker = function(name, type)
	ivkr_push_string("_T")
	ivkr_gettable(-10002)

	ivkr_push_string("AddHudTracker")
	ivkr_gettable(-2)

	ivkr_push_string(name)
	ivkr_push_int(type)
	ivkr_call2(2, 0)
end

_T = setmetatable({}, {
	function __index(name)
		if name == "AddHudTracker" then
			ivkr_push_string("_T")
			ivkr_gettable(-10002)
			ivkr_push_string("AddHudTracker")
			local ok = ivkr_gettable(-2) > 0
			ivkr_pop(2)
			return ok ? AddHudTracker : nil
		end
		return rawget(self, name)
	end
})

ivkr_find_builtin = function(name)
	ivkr_push_string(name)
	ivkr_gettable(-10002)
	return ivkr_pop_c_function(1)
end

