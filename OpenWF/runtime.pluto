class HumanPlayer extends Player
	__name = "HumanPlayer"

	function ToggleFreeCamera()
		luau_push_object(self.addr)
		luau_call(luau_find_method("HumanPlayer", "ToggleFreeCamera"), 1)
	end

	function isControllingCamera()
		return player_get_controlling_camera(self.addr)
	end

	function setControllingCamera(b)
		player_set_controlling_camera(self.addr, b)
	end

	function AssignAvatar(avatar, b1 = true, b2 = true)
		luau_push_object(self.addr)
		luau_push_object(avatar.addr)
		luau_push_bool(b1)
		luau_push_bool(b2)
		luau_call(luau_find_method("HumanPlayer", "AssignAvatar"), 4)
	end
end

class BaseEntity extends Object
	__name = "BaseEntity"

end

local function pop_entity()
	if addr := luau_pop_object() then
		local obj = new Entity(addr)
		local type = obj:GetType()
		repeat
			switch type:GetFullName() do
				case "/EE/Types/Engine/BaseMarkerInfo": return new BaseMarkerInfo(addr)
				case "/EE/Types/Effects/LensFlare": return new LensFlare(addr)
				case "/EE/Types/Engine/Decoration": return new Decoration(addr)
				case "/Lotus/Types/Game/LotusAvatar": return new LotusAvatar(addr)
				case "/Lotus/Types/Game/LotusNpcAvatar": return new LotusNpcAvatar(addr)
			end
			type = type:GetParent()
		until not type
		return obj
	else
		luau_pop(1)
	end
end

class Entity extends BaseEntity
	__name = "Entity"

	function GetPosition()
		return new Vector(entity_get_pos(self.addr))
	end

	function SetPosition(pos)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("Entity", "GetPosition"), 1)
		end
		local ud = luau_get_userdata()
		mem_write_f32(ud + 0x20, pos.x)
		mem_write_f32(ud + 0x24, pos.y)
		mem_write_f32(ud + 0x28, pos.z)
		luau_call(luau_find_method("Entity", "SetPosition"), 2)
	end

	function DistanceToEntity(b)
		return GetPosition():distance(b:GetPosition())
	end

	function GetRotation()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetRotation"), 1)
		local ud = luau_pop_userdata()
		return new Rotation(mem_read_f32(ud + 0x20), mem_read_f32(ud + 0x24), mem_read_f32(ud + 0x28))
	end

	function SetRotation(rot)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("Entity", "GetRotation"), 1)
		end
		local ud = luau_get_userdata()
		mem_write_f32(ud + 0x20, rot.x)
		mem_write_f32(ud + 0x24, rot.y)
		mem_write_f32(ud + 0x28, rot.z)
		luau_call(luau_find_method("Entity", "SetRotation"), 2)
	end

	function GetHealth()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetHealth"), 1)
		return math.tointeger(luau_pop_number())
	end

	function SetHealth(health)
		luau_push_object(self.addr)
		luau_push_int(health)
		luau_call(luau_find_method("Entity", "SetHealth"), 2)
	end

	function GetDrawOnTop()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetDrawOnTop"), 1)
		return luau_pop_bool()
	end

	function SetDrawOnTop(b)
		luau_push_object(self.addr)
		luau_push_bool(b)
		luau_call(luau_find_method("Entity", "SetDrawOnTop"), 2)
	end

	function GetMeshScale()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetMeshScale"), 1)
		return luau_pop_number()
	end

	function SetMeshScale(f)
		luau_push_object(self.addr)
		luau_push_float(f)
		luau_call(luau_find_method("Entity", "SetMeshScale"), 2)
	end

	function SetMesh(object, b1, b2)
		luau_push_object(self.addr)
		luau_push_object(object.addr)
		luau_push_bool(b1)
		luau_push_bool(b2)
		luau_call(luau_find_method("Entity", "SetMesh"), 4)
	end

	function Attach(type, symbol, optionalPosOffset)
		luau_push_object(self.addr)
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		(symbol or EMPTY_SYMBOL):pushToLuau()
		if optionalPosOffset then
			luau_push_object(self.addr)
			luau_call(luau_find_method("Entity", "GetPosition"), 1)
			local ud = luau_get_userdata()
			mem_write_f32(ud + 0x20, optionalPosOffset.x)
			mem_write_f32(ud + 0x24, optionalPosOffset.y)
			mem_write_f32(ud + 0x28, optionalPosOffset.z)
		end
		luau_call(luau_find_method("Entity", "Attach"), optionalPosOffset ? 4 : 3)
		return pop_entity()
	end

	function GetAttachment(type)
		luau_push_object(self.addr)
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("Entity", "GetAttachment"), 2)
		return pop_entity()
	end

	function GetTag()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetTag"), 1)
		luau_call(luau_find_method("Symbol", "__tostring"), 1)
		return new Symbol(luau_pop_string())
	end

	function FirePort(port)
		luau_push_object(self.addr)
		luau_push_string(port)
		luau_call(luau_find_method("Entity", "FirePort"), 2)
	end

	function SetVisibility(visible, delegateToAttachments = false)
		luau_push_object(self.addr)
		luau_push_bool(visible)
		luau_push_bool(delegateToAttachments)
		luau_call(luau_find_method("Entity", "SetVisibility"), 3)
	end

	function GetSpeed()
		luau_push_object(self.addr)
		luau_call(luau_find_method("Entity", "GetSpeed"), 1)
		return luau_pop_number()
	end
end

class BaseAvatar extends Entity
	__name = "BaseAvatar"

	function GetMaxHealth(b = true)
		luau_push_object(self.addr)
		luau_push_bool(b)
		luau_call(luau_find_method("BaseAvatar", "GetMaxHealth"), 2)
		return math.tointeger(luau_pop_number())
	end

	function SetMaxHealth(health, b = false)
		luau_push_object(self.addr)
		luau_push_int(health)
		luau_push_bool(b)
		luau_call(luau_find_method("BaseAvatar", "SetMaxHealth"), 3)
	end

	function Suicide()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "Suicide"), 1)
	end

	function DamageControl()
		if addr := baseavatar_get_damage_controller(self.addr) then
			return new LotusDamageController(addr)
		end
	end

	function InventoryControl()
		if addr := baseavatar_get_inventory_controller(self.addr) then
			local inventory = new LotusInventoryController(addr)
			if not "NullInventoryController" in inventory:GetFullName() then
				return new LotusInventoryController(addr)
			end
		end
	end

	function InputControl()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "InputControl"), 1)
		if addr := luau_pop_object() do
			return new InputController(addr)
		end
	end

	function GiveItem(type, b)
		luau_push_object(self.addr)
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_push_bool(b)
		luau_pop(luau_call(luau_find_method("BaseAvatar", "GiveItem"), 3))
	end

	function MotionControl()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "MotionControl"), 1)
		if addr := luau_pop_object() do
			return new MotionControllerBase(addr)
		end
	end

	function GetView()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "GetView"), 1)
		local ud = luau_pop_userdata()
		return new Rotation(mem_read_f32(ud + 0x20), mem_read_f32(ud + 0x24), mem_read_f32(ud + 0x28))
	end

	function SetView(rot)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("BaseAvatar", "GetView"), 1)
		end
		local ud = luau_get_userdata()
		mem_write_f32(ud + 0x20, rot.x)
		mem_write_f32(ud + 0x24, rot.y)
		mem_write_f32(ud + 0x28, rot.z)
		luau_call(luau_find_method("BaseAvatar", "SetView"), 2)
	end

	function GetCameraView()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "GetCameraView"), 1)
		local ud = luau_pop_userdata()
		return new Rotation(mem_read_f32(ud + 0x20), mem_read_f32(ud + 0x24), mem_read_f32(ud + 0x28))
	end

	function SetCameraView(rot)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("BaseAvatar", "GetCameraView"), 1)
		end
		local ud = luau_get_userdata()
		mem_write_f32(ud + 0x20, rot.x)
		mem_write_f32(ud + 0x24, rot.y)
		mem_write_f32(ud + 0x28, rot.z)
		luau_call(luau_find_method("BaseAvatar", "SetCameraView"), 2)
	end

	function SetEyePosition(pos)
		luau_push_object(self.addr)
		do
			luau_push_object(self.addr)
			luau_call(luau_find_method("Entity", "GetPosition"), 1)
		end
		local ud = luau_get_userdata()
		mem_write_f32(ud + 0x20, pos.x)
		mem_write_f32(ud + 0x24, pos.y)
		mem_write_f32(ud + 0x28, pos.z)
		luau_call(luau_find_method("BaseAvatar", "SetEyePosition"), 2)
	end

	function GetFaction()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "GetFaction"), 1)
		luau_call(luau_find_method("Symbol", "__tostring"), 1)
		return new Symbol(luau_pop_string())
	end

	function GetOriginalFaction()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "GetOriginalFaction"), 1)
		luau_call(luau_find_method("Symbol", "__tostring"), 1)
		return new Symbol(luau_pop_string())
	end

	function SetFaction(symbol)
		luau_push_object(self.addr)
		symbol:pushToLuau()
		luau_call(luau_find_method("BaseAvatar", "SetFaction"), 2)
	end

	function GetLocTag()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "GetLocTag"), 1)
		luau_call(luau_find_method("Symbol", "__tostring"), 1)
		return new Symbol(luau_pop_string())
	end

	function ClearAgent()
		luau_push_object(self.addr)
		luau_call(luau_find_method("BaseAvatar", "ClearAgent"), 1)
	end

	function PushInputFilter(resource)
		luau_push_object(self.addr)
		do
			luau_push_string(resource)
			luau_call(mem_read_i64(mem_scan_exe("C6 BB 09 B0 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("BaseAvatar", "PushInputFilter"), 2)
	end
end

