coroutine.sleep = function(ms)
	local t = os.millis() + ms
	repeat
		yield()
	until t <= os.millis()
end

Sleep = coroutine.sleep

owf_internal_event_queue = {}
owf_lambda_callbacks = {}
owf_next_event = || -> owf_internal_event_queue:remove(1)

ivkr_push_callback = function(callback)
	local callbackName = tostring(callback)
	if type(callback) == "function" then
		owf_lambda_callbacks[callbackName] = callback
	end
	ivkr_push_string("OWF_"..owf_script_get_path()..callbackName)
	owf_register_callback(callbackName)
end

return function(f)
	owf_script_route_base = owf_script_get_path():sub(7)
	owf_register_custom_route(owf_script_route_base.."/request_broadcast", "text/plain", "")
	owf_register_custom_route(owf_script_route_base.."/set_toggle", "text/plain", "")

	coroutine.yield()

	local simple_yield = coroutine.yield
	coroutine.yield = yield

	local sched = new scheduler()
	sched.yieldfunc = simple_yield
	sched.errorfunc = function(e)
		if type(e) == "string" and e:sub(-14) == "Stop requested" then
			print(e)
		else
			print(debug.traceback(e,2))
		end
	end
	owf_create_thread = |x| -> sched:add(x)
	local mainco
	sched:add(function()
		repeat
			simple_yield()
			while evt := owf_internal_next_event() do
				if evt.type == OWF_EVT_CUSTOM_ROUTE_SERVED then
					local path = url.decode(evt.path)
					if path:sub(1, #owf_script_route_base) == owf_script_route_base then
						local off = 1 + #owf_script_route_base
						if path:sub(off) == "/request_broadcast" then
							owf_broadcast_message(json.encode({
								from = owf_script_get_path(),
								script_broadcast = {
									toggles = owf_script_toggles,
								},
							}))
							continue
						end
						if path:sub(off, off + 11) == "/set_toggle?" then
							local value = path:sub(off + 12, off + 12) == "1"
							local name = path:sub(off + 13)
							if toggle := owf_script_toggles:find(|x| -> x.name == name) then
								toggle.value = value
							else
								print("Could not find a toggle called "..name)
							end
						end
					end
				elseif evt.type == OWF_EVT_CALLBACK then
					evt.name = evt.name:sub(1 + #owf_script_get_path())
					if cb := owf_lambda_callbacks[evt.name] then
						sched:add(cb)
						owf_lambda_callbacks[evt.name] = nil
						continue
					end
				elseif evt.type == OWF_EVT_SCRIPT_TRIGGERED then
					local arr = evt.data:split(":")
					evt.script = arr[1]
					evt.func = arr[2]
					evt.data = nil
				end
				owf_internal_event_queue:insert(evt)
			end
		until mainco:status() == "dead" and (owf_lambda_callbacks:size() == 0 or owf_get_stop_requested())
	end)
	mainco = sched:add(f)
	simple_yield()
	sched:run()
end
