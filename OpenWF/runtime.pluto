class RadialRegion extends owfUserdata
	__name = "RadialRegion"

	function __index(name)
		if RadialRegion[name] then
			return RadialRegion[name]
		end
		switch name do
			case "name":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialRegion", name), 1)
				return ivkr_pop_string()

			case "sectors":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialRegion", name), 1)
				return ivkr_pop_array(RadialSector)

			case "droneDamage":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialRegion", name), 1)
				return ivkr_pop_range()

			case "damageChance":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialRegion", name), 1)
				return ivkr_pop_number()

			case "resources":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialRegion", name), 1)
				return ivkr_pop_array(PickUpTypeRarity)
		end
		error("Unknown field: "..name)
	end
end

class RadialSector extends owfUserdata
	__name = "RadialSector"

	function __newindex(name, value)
		if RadialSector[name] then
			return rawset(self, name, value)
		end
		switch name do
			case "unlocked":
				self:pushToIvkr()
				ivkr_push_bool(value)
				ivkr_call(ivkr_find_setter("RadialSector", "unlocked"), 2)
				return
		end
		error("Unknown field: "..name)
	end

	function __index(name)
		if RadialSector[name] then
			return rawget(self, name)
		end
		switch name do
			case "name":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialSector", "name"), 1)
				ivkr_call(ivkr_find_method("Symbol", "__tostring"), 1)
				return new Symbol(ivkr_pop_string())

			case "unlocked":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialSector", "unlocked"), 1)
				return ivkr_pop_bool()

			case "nodeType":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialSector", "nodeType"), 1)
				return math.tointeger(ivkr_pop_number())

			case "missionTag":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialSector", "missionTag"), 1)
				ivkr_call(ivkr_find_method("Symbol", "__tostring"), 1)
				return new Symbol(ivkr_pop_string())

			case "mission":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("RadialSector", "mission"), 1)
				return new LotusMissionInfo()
		end
		error("Unknown field: "..name)
	end
end

class LotusMissionInfo extends owfUserdata
	__name = "LotusMissionInfo"

	function __index(name)
		if LotusMissionInfo[name] then
			return LotusMissionInfo[name]
		end
		switch name do
			case "missionType":
			case "minEnemyLevel":
			case "maxEnemyLevel":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusMissionInfo", name), 1)
				return math.tointeger(ivkr_pop_number())

			case "goalTag":
			case "activeMissionTag":
			case "location":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusMissionInfo", name), 1)
				ivkr_call(ivkr_find_method("Symbol", "__tostring"), 1)
				return new Symbol(ivkr_pop_string())

			case "levelOverride":
			case "gameRules":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusMissionInfo", name), 1)
				if ivkr_type(-1) > 0 then 
					return new ObjectType()
				end
				ivkr_pop(1)
				return nil

			case "buddyAgents":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusMissionInfo", name), 1)
				return ivkr_pop_array(ObjectType)

			case "missionReward":
			case "missionRewardExtra":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusMissionInfo", name), 1)
				if ivkr_type(-1) > 0 then 
					return new MissionReward()
				end
				ivkr_pop(1)
				return nil
		end
		error("Unknown field: "..name)
	end

	function EncodeAsString()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("LotusMissionInfo", "EncodeAsString"), 1)
		return ivkr_pop_string()
	end

