Engine = {}

class Engine.OpenLevelArgs
	__name = "Engine.OpenLevelArgs"

	private level
	private gamerules
	private context_tags

	function SetLevel(level)
		self.level = level
	end

	function SetGameRules(gamerules)
		self.gamerules = gamerules
	end

	function AddContextTag(tag)
		self.context_tags ??= {}
		self.context_tags:insert(tag)
	end

	function pushToLuau()
		luau_call(luau_find_ctor("OpenLevelArgs"), 0)

		luau_push_value(-1)
		luau_push_string(self.level)
		luau_call(luau_find_method("OpenLevelArgs", "SetLevel"), 2)

		if self.gamerules then
			luau_push_value(-1)
			luau_push_string(self.gamerules)
			luau_call(luau_find_method("OpenLevelArgs", "SetGameRules"), 2)
		end

		if self.context_tags then
			for self.context_tags as tag do
				luau_push_value(-1)
				luau_push_string(tag)
				luau_call(luau_find_method("OpenLevelArgs", "AddContextTag"), 2)
			end
		end
	end
end
setmetatable(Engine.OpenLevelArgs, { __call = || -> new Engine.OpenLevelArgs() })

class Symbol
	__name = "Symbol"

	function __construct(public name = "")
	end

	function __eq(b)
		return self.name == b.name
	end

	function __tostring()
		return self.name
	end

	function c_str()
		return self.name
	end

	function pushToLuau()
		luau_push_string(self.name)
		luau_call(luau_find_ctor("Symbol"), 1)
	end
end
setmetatable(Symbol, { __call = |_, name| -> new Symbol(name) })

function IsNull(val)
	return not val
end

function Type(name)
	return name
end

Sleep = coroutine.sleep

function Resource(name)
	return name
end

function WeakResource(name)
	return name
end

function Range(min, max)
	return { min = min, max = max }
end

function Color(r, g, b, a)
	return { r = r, g = g, b = b, a = a }
end

function Localize(loctag, subs = {})
	luau_push_string(loctag)
	luau_newtable()
	for k, v in subs do
		luau_push_string(k)
		luau_push_string(v)
		luau_settable(-3)
	end
	luau_call(mem_read_i64(mem_scan_exe("AD 36 36 60 00 00 00 00") + 8), 2)
	return luau_pop_string()
end

function Engine.OpenLevel(args)
	args:pushToLuau()
	luau_call(mem_read_i64(mem_scan_exe("FC 1D 0A 4E 00 00 00 00") + 8), 1)
end

-- compatibility with older versions of OpenWF that had these incorrectly scoped
OpenLevelArgs = Engine.OpenLevelArgs
OpenLevel = Engine.OpenLevel

gRegion = {
	function GetLocalPlayer()
		if player := get_local_player() then
			return new HumanPlayer(player)
		end
	end,
	function GetLocalPlayerAvatar()
		if player := get_local_player() then
			if avatar := player_get_avatar(player) then
				return new LotusAvatar(avatar)
			end
		end
	end,
	function GetGameCamera()
		if camera := get_game_camera() then
			return new Entity(camera)
		end
	end,
	function GetGameRules()
		local obj = new Object(get_gamerules())
		local type = obj:GetType()
		if type:isNameInHierarchy("LotusAttractModeGameRules") then
			return new LotusAttractModeGameRules(obj.addr)
		end
		if type:isNameInHierarchy("LotusGameRules") then
			return new LotusGameRules(obj.addr)
		end
		if type:isNameInHierarchy("GameRulesImpl") then
			return new GameRulesImpl(obj.addr)
		end
		return obj
	end,
	function GetAvatars()
		luau_push_object(get_regionmgr())
		luau_call(luau_find_method("RegionMgrImpl", "GetAvatars"), 1)
		local t = {}
		local i = 1
		while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
			t:insert(new LotusAvatar(luau_pop_object()))
			++i
		end
		luau_pop(2)
		return t
	end,
	function FindFirstTagged(symbol)
		luau_push_object(get_regionmgr())
		symbol:pushToLuau()
		luau_call(luau_find_method("RegionMgrImpl", "FindFirstTagged"), 2)
		if obj := luau_pop_object() then
			return new LotusAvatar(obj)
		else
			luau_pop(1)
		end
	end,
	function FindTagged(symbol)
		luau_push_object(get_regionmgr())
		symbol:pushToLuau()
		luau_call(luau_find_method("RegionMgrImpl", "FindTagged"), 2)
		local t = {}
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				t:insert(new LotusAvatar(luau_pop_object()))
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
		return t
	end,
	function FindAll(type)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "FindAll"), 2)
		local t = {}
		if luau_istable(-1) then
			local i = 1
			while (luau_push_int(i) and nil) or (luau_gettable(-2) > 0) do
				t:insert(pop_entity())
				++i
			end
			luau_pop(2)
		else
			luau_pop(1)
		end
		return t
	end,
	function CreateObject(type)
		luau_push_object(get_regionmgr())
		do
			luau_push_string(type)
			luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("RegionMgrImpl", "CreateObject"), 2)
		return new Object(luau_pop_object())
	end,
	function CreateEntity(type, pos, rot)
		if avatar := gRegion:GetLocalPlayerAvatar() then
			luau_push_object(get_regionmgr())
			do
				luau_push_string(type)
				luau_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetPosition"), 1)
				if pos then -- optional for compatibility with older OpenWF versions
					local ud = luau_get_userdata()
					mem_write_f32(ud + 0x20, pos.x)
					mem_write_f32(ud + 0x24, pos.y)
					mem_write_f32(ud + 0x28, pos.z)
				end
			end
			do
				luau_push_object(avatar.addr)
				luau_call(luau_find_method("Entity", "GetRotation"), 1)
				if rot then -- optional for compatibility with older OpenWF versions
					local ud = luau_get_userdata()
					mem_write_f32(ud + 0x20, rot.x)
					mem_write_f32(ud + 0x24, rot.y)
					mem_write_f32(ud + 0x28, rot.z)
				end
			end
			luau_call(luau_find_method("RegionMgrImpl", "CreateEntity"), 4)
			return pop_entity()
		end
	end,
	function GetNpcMgr()
		luau_push_object(get_regionmgr())
		luau_call(luau_find_method("RegionMgrImpl", "GetNpcMgr"), 1)
		return new NpcManager(luau_pop_object())
	end,
}

setmetatable(_G, {
	function __index(name)
		if name == "gGameRules" then
			return gRegion:GetGameRules()
		end
		if name == "gStarChart" then
			local gr = gRegion:GetGameRules()
			if gr instanceof LotusAttractModeGameRules then
				return gr:GetStarChart()
			end
			return gr:GetCurrentStarChart()
		end
		return rawget(self, name)
	end
})

gFlashMgr = {
	function ExecuteToolMenuCommand(resource)
		luau_push_object(get_flashmgr())
		do
			luau_push_string(resource)
			luau_call(mem_read_i64(mem_scan_exe("C6 BB 09 B0 00 00 00 00") + 8), 1)
		end
		luau_call(luau_find_method("FlashMgr", "ExecuteToolMenuCommand"), 2)
	end,
}

gGameData = {
	function SyncInventoryFromDB(callbackName)
		luau_push_object(get_gamedata())
		if callbackName then
			owf_register_callback(callbackName)
			luau_push_string("OWF_"..callbackName)
		else
			luau_push_string("WantsEndOfMatchPreview") -- Basically a no-op
		end
		luau_call(luau_find_method("LotusProfileData", "SyncInventoryFromDB"), 2)
	end,
}

gEntityType = Type("/EE/Types/Engine/Entity")
gLotusGameRulesType = Type("/Lotus/Types/Game/LotusGameRules")
gLotusBasePvpGameRulesType = Type("/Lotus/Types/Game/LotusBasePvpGameRules")
gLotusHubGameRulesType = Type("/Lotus/Types/Game/LotusHubGameRules")
gLotusDuelGameRulesType = Type("/Lotus/Types/Game/LotusDuelGameRules")

ZERO_VECTOR = Vector()
ZERO_ROTATION = Rotation()
EMPTY_SYMBOL = Symbol()

Engine.SLOT_1 = 0
Engine.SLOT_2 = 1
Engine.SLOT_3 = 2
Engine.SLOT_4 = 3
Engine.SLOT_5 = 4
Engine.SLOT_6 = 5
Engine.SLOT_7 = 6
Engine.SLOT_8 = 7
Engine.SLOT_9 = 8
Engine.SLOT_10 = 9
Engine.SLOT_11 = 10
Engine.SLOT_12 = 11
Engine.SLOT_13 = 12
Engine.SLOT_14 = 13
Engine.INVALID = 14

local { http, json, url } = require "*"

function owf_get_running_scripts()
	return (http.request("http://localhost:61558/status") |> json.decode).running_scripts
end

function owf_start_script(name)
	http.request("http://localhost:61558/start_script?"..url.encode("OpenWF/scripts/"..name))
end

function owf_stop_script(name)
	http.request("http://localhost:61558/stop_script?"..url.encode("OpenWF/scripts/"..name))
end

OWF_FONT_SIMPLE8 = 8
OWF_FONT_SIMPLE5 = 5

owf_overlay_set_color = owf_overlay_set_colour

OWF_EVT_BLOCKED_CHAT_MESSAGE = 1
OWF_EVT_CUSTOM_ROUTE_SERVED = 2
OWF_EVT_CALLBACK = 3

UpgradeType = setmetatable({}, {
	__index = |t, k| -> rawset(t, k, luau_get_enum_value(k))[k]
})

OperationType = {
	ADD = 0,
	ADD_BASE = 1,
	MULTIPLY = 2,
	STACKING_MULTIPLY = 3,
	SET = 4,
	SET_BASE = 5,
	SET_MIN = 6,
	SET_MAX = 7
}

coroutine.sleep = function(ms)
	local t = os.millis() + ms
	repeat
		yield()
	until t <= os.millis()
end

return function(f)
	coroutine.yield()
	coroutine.yield = yield
	xpcall(f, function(e)
		if type(e) == "string" and e:sub(-14) == "Stop requested" then
			print(e)
		else
			print(debug.traceback(e,2))
		end
	end)
end
