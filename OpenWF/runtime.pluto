class NpcManager extends EngineNpcMgr
	__name = "NpcManager"

	function PauseAllAgents()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("NpcManager", "PauseAllAgents"), 1)
	end

	function CreateAgentAtPosition(type, pos, rot, optionalSymbol, optionalLevel)
		self:pushToIvkr()
		do
			ivkr_push_string(type)
			ivkr_call(mem_read_i64(mem_scan_exe("5E C2 EF 88 00 00 00 00") + 8), 1)
		end
		ivkr_push_vector(pos)
		ivkr_push_rotation(rot)
		;(optionalSymbol or EMPTY_SYMBOL):pushToIvkr()
		ivkr_push_int(optionalLevel or 0)
		ivkr_call(ivkr_find_method("NpcManager", "CreateAgentAtPosition"), 6)
		return new EngineNpcAgent()
	end
end

