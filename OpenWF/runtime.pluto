class InventoryControllerBase extends Object
	__name = "InventoryControllerBase"

	function RemoveItem(slot, b)
		luau_push_object(self.addr)
		luau_push_int(slot)
		luau_push_bool(b)
		luau_call(luau_find_method("InventoryControllerBase", "RemoveItem"), 3)
	end

	function GetWeaponInHand(hand)
		if weapon := inventory_get_weapon_in_hand(self.addr, hand) then
			return new LotusWeapon(weapon)
		end
	end

	function AddUpgrade(upgradeType, operationType, value)
		luau_push_object(self.addr)
		luau_push_int(upgradeType)
		luau_push_int(operationType)
		luau_push_float(value)
		luau_call(luau_find_method("NullInventoryController", "AddUpgrade"), 4)
	end
end

class LotusInventoryController extends InventoryControllerBase
	__name = "LotusInventoryController"

	function GetActivePowerSuit()
		if addr := inventory_get_active_powersuit(self.addr) then
			return new PowerSuit(addr)
		end
	end

	function DoItemDrop()
		luau_push_object(self.addr)
		luau_pop(luau_call(luau_find_method("LotusInventoryController", "DoItemDrop"), 1))
	end
end

class Item extends Object
	__name = "Item"

	function GetAttachmentEntity(category, hand = 4)
		-- restricting category to avoid access violations
		if category == 0 or category == 1 then
			luau_push_object(self.addr)
			luau_push_int(category)
			luau_push_int(hand)
			luau_call(luau_find_method("Item", "GetAttachmentEntity"), 3)
			if addr := luau_pop_object() then
				return new Entity(addr)
			end
		end
	end
end

