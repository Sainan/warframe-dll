	end

	function SetCoverRightViewOffset(vec)
		return self:implSetVector("SetCoverRightViewOffset", vec)
	end

	function SetCrouchCoverAimLeftViewOffset(vec)
		return self:implSetVector("SetCrouchCoverAimLeftViewOffset", vec)
	end

	function SetCrouchCoverAimRightViewOffset(vec)
		return self:implSetVector("SetCrouchCoverAimRightViewOffset", vec)
