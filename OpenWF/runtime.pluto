class WeaponImpactBehavior extends Object
	__name = "WeaponImpactBehavior"

	function __index(name)
		if Object[name] then
			return Object[name]
		end
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				luau_push_object(self.addr)
				luau_call(luau_find_getter("WeaponImpactBehavior", name), 1)
				return luau_pop_number()
		end
	end

	function __newindex(name, value)
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				luau_push_object(self.addr)
				luau_push_float(value)
				luau_call(luau_find_setter("WeaponImpactBehavior", name), 2)
		end
	end
end
