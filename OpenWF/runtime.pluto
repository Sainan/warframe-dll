class StoreManifest extends Object
	__name = "StoreManifest"

	function GetStoreItemsOfType(objectType)
		self:pushToIvkr()
		ivkr_push_pointer(objectType.addr)
		ivkr_call(ivkr_find_method("StoreManifest", "GetStoreItemsOfType"), 2)
		local t = {}
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(new StoreItem())
			++i
		end
		ivkr_pop(2)
		return t
	end
end

