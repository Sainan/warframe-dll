owf_script_toggles = {}
function owf_script_add_toggle(name, value = false)
	local toggle = {
		name = name,
		value = value
	}
	owf_script_toggles:insert(toggle)
	return toggle
end

function owf_get_available_scripts()
	return http.request("http://localhost:61558/scripts") |> json.decode
end

function owf_get_running_scripts()
	return (http.request("http://localhost:61558/status") |> json.decode).running_scripts:map(|x| -> x:sub(16))
end

function owf_start_script(name)
	http.request("http://localhost:61558/start_script?"..url.encode("OpenWF/scripts/"..name))
end

function owf_stop_script(name)
	http.request("http://localhost:61558/stop_script?"..url.encode("OpenWF/scripts/"..name))
end

