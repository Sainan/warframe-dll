class FlashMarker extends owfClassBase
	__name = "FlashMarker"

	function ScreenX()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenX"), 1)
		return luau_pop_number()
	end

	function ScreenY()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenY"), 1)
		return luau_pop_number()
	end

	function ScreenZ()
		luau_push_pointer(self.addr)
		luau_call(luau_find_method("FlashMarker", "ScreenZ"), 1)
		return luau_pop_number()
	end

	function __index(name)
		if FlashMarker[name] then
			return FlashMarker[name]
		end
		switch name do
			case "garbage":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return luau_pop_bool()

			case "markerType":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return math.tointeger(luau_pop_number())

			case "distanceToEye":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", name), 1)
				return luau_pop_number()

			case "pos":
				do
					luau_push_pointer(self.addr)
					luau_call(luau_find_getter("FlashMarker", name), 1)
					local addr = mem_read_i64(luau_pop_userdata() + 0x18)
					return new Vector(mem_read_f32(addr + 0x18), mem_read_f32(addr + 0x10), mem_read_f32(addr + 0x14))
				end
				break

			case "baseMarkerInfo":
				luau_push_pointer(self.addr)
				luau_call(luau_find_getter("FlashMarker", "baseMarkerInfo"), 1)
				return new BaseMarkerInfo(luau_pop_object())
		end
		error("Unknown field: "..name)
	end
end
FlashMarker.__parent = nil -- Hack so our __index is used

