	__name = "CountedItem"

	function __construct()
		parent:__construct()

		self:pushToIvkr()
		ivkr_call(ivkr_find_getter("CountedItem", "mItemType"), 1)
		self.mItemType = new ObjectType()

		self:pushToIvkr()
		ivkr_call(ivkr_find_getter("CountedItem", "mItemCount"), 1)
		self.mItemCount = math.tointeger(ivkr_pop_number())
	end
end

