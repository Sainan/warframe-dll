class WeaponCustomization extends owfUserdata
	__name = "WeaponCustomization"

	function GetSkin(iSlot)
		self:pushToIvkr()
		ivkr_push_int(iSlot)
		ivkr_call(ivkr_find_method("WeaponCustomization", "GetSkin"), 2)
		if ivkr_type(-1) > 0 then
			return new ObjectType()
		else
			ivkr_pop(1)
		end
	end

	function SetSkin(objectType, iSlot)
		self:pushToIvkr()
		objectType:pushToIvkr()
		ivkr_push_int(iSlot)
		ivkr_call(ivkr_find_method("WeaponCustomization", "SetSkin"), 3)
	end

	function GetColors(i)
		assert(i <= 6)
		self:pushToIvkr()
		ivkr_push_int(i)
		ivkr_call(ivkr_find_method("WeaponCustomization", "GetColors"), 2)
		return new CustomizationColorPalette()
	end

	function SetColors(i, v)
		assert(i <= 6)
		self:pushToIvkr()
		ivkr_push_int(i)
		v:pushToIvkr()
		ivkr_call(ivkr_find_method("WeaponCustomization", "SetColors"), 3)
	end
end

class CustomizationColorPalette extends owfUserdata
	__name = "CustomizationColorPalette"

	function __index(name)
		if CustomizationColorPalette[name] then
			return CustomizationColorPalette[name]
		end
		switch name do
			case "mTintColor0":
			case "mTintColor1":
			case "mTintColor2":
			case "mTintColor3":
			case "mEmissiveColor0":
			case "mEmissiveColor1":
			case "mEnergyColor":
			case "mEnergyColor1":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("CustomizationColorPalette", name), 1)
				return ivkr_pop_color()
		end
		error("Unknown field: "..name)
	end

	function __newindex(name, value)
		if owfUserdata[name] then
			return owfUserdata[name]
		end
		switch name do
			case "mTintColor0":
			case "mTintColor1":
			case "mTintColor2":
			case "mTintColor3":
			case "mEmissiveColor0":
			case "mEmissiveColor1":
			case "mEnergyColor":
			case "mEnergyColor1":
				self:pushToIvkr()
				value:pushToIvkr()
				ivkr_call(ivkr_find_setter("CustomizationColorPalette", name), 2)
				return
		end
		error("Unknown field: "..name)
	end

	function GetColor(i)
		self:pushToIvkr()
		ivkr_push_int(i)
		ivkr_call(ivkr_find_method("CustomizationColorPalette", "GetColor"), 2)
		return ivkr_pop_color()
	end

	function SetColor(i, c)
		self:pushToIvkr()
		ivkr_push_int(i)
		c:pushToIvkr()
		ivkr_call(ivkr_find_method("CustomizationColorPalette", "SetColor"), 3)
	end

	function Initialized(i)
		self:pushToIvkr()
		ivkr_push_int(i)
		ivkr_call(ivkr_find_method("CustomizationColorPalette", "Initialized"), 2)
		return ivkr_pop_bool()
	end

	function SetInitialized(i, b)
		self:pushToIvkr()
		ivkr_push_int(i)
		ivkr_push_bool(b)
		ivkr_call(ivkr_find_method("CustomizationColorPalette", "SetInitialized"), 3)
	end
end

