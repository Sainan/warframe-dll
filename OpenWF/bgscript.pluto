local { base64, crypto, http, json } = require "*"

if not io.exists("OpenWF/Metadata Patches.txt") then
	io.contents("OpenWF/Metadata Patches.txt", owf_archive_find("OpenWF/Metadata Patches.txt"))
end

if owf_overlay_get_size() ~= 0xFFFFFFFF then -- Just applied hotfix?
	print_to_console("Background script has successfully restarted.")
	owf_command("clear_script_log")
elseif compareversions(owf_get_build_version(), "2023.07.26.16.38") >= 0 then -- This cache stuff is for echoes of duviri and up
	local function b64m_encode(data)
		return base64.encode(data, false):replace("/", "-")
	end

	local function b64m_decode(data)
		return base64.decode(data:replace("-", "/"))
	end

	local function shcc_decompress_chunk_oodle(bin, i, decompressed_size)
		local decompressed = ""
		while #decompressed < decompressed_size do
			local block_info = bin:sub(i, i + 7)
			i += 8
			assert(block_info:byte(1) == 0x80)
			assert((block_info:byte(8) & 0x0F) == 0x01)
			local num1 = (block_info:byte(1) << 24) | (block_info:byte(2) << 16) | (block_info:byte(3) << 8) | block_info:byte(4)
			local num2 = (block_info:byte(5) << 24) | (block_info:byte(6) << 16) | (block_info:byte(7) << 8) | block_info:byte(8)
			local block_compressed_size = (num1 >> 2) & 0xFFFFFF
			local block_decompressed_size = (num2 >> 5) & 0xFFFFFF
			assert(bin:byte(i) == 0x8C)
			decompressed ..= oodle_decompress(bin:sub(i, i + block_compressed_size - 1), block_decompressed_size)
			i += block_compressed_size
		end
		return decompressed, i
	end

	local function shcc_decompress_chunk(bin, i)
		local chunk_type, decompressed_size, compressed_size
		chunk_type, i = string.unpack("<I1", bin, i)	
		decompressed_size, i = string.unpack("<I4", bin, i)
		compressed_size, i = string.unpack("<I4", bin, i)
		if chunk_type == 0 then
			assert(compressed_size == decompressed_size)
			local data = bin:sub(i, i + compressed_size - 1)
			i += decompressed_size
			return data, i
		end
		assert(chunk_type == 2)
		return shcc_decompress_chunk_oodle(bin, i, decompressed_size)
	end

	local function shcc_unpack(bin)
		local i = 1
		i += 8
		local data = {}
		data.H, i = shcc_decompress_chunk(bin, i)
		try
			data.B, i = shcc_decompress_chunk(bin, i)
		catch _ then
		end
		return data
	end

	local class CacheManifest
		function __construct(bin)
			self.inst = owf_cachemanifest_new(bin)
		end

		function getHash(path)
			return owf_cachemanifest_get_hash(self.inst, path)
		end

		function setHash(path, hash)
			owf_cachemanifest_set_hash(self.inst, path, hash)
		end

		function pack()
			return "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00".."\x0D\x00\x00\x00"..owf_cachemanifest_pack_entries(self.inst)
		end
	end

	local function shcc_pack_H(compressed, decompressed_size)
		local bin = "SHCC\x1f\x00\x00\x00"
		bin ..= string.pack("<I1I4s4", 2, decompressed_size, compressed)
		bin ..= "\x00\xFF\xFF\xFF\xFF\x00\x00\x00\x00\x00\xFF\xFF\xFF\xFF\x00\x00\x00\x00\x52"
		return bin .. string.pack("<I4", crypto.crc32c(bin))
	end

	local function shcc_pack_HB(H_compressed, H_decompressed_size, B_compressed, B_decompressed_size)
		local bin = "SHCC\x1f\x00\x00\x00"
		bin ..= string.pack("<I1I4s4", 2, H_decompressed_size, H_compressed)
		bin ..= string.pack("<I1I4s4", 2, B_decompressed_size, B_compressed)
		bin ..= "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x52"
		return bin .. string.pack("<I4", crypto.crc32c(bin))
	end

	local function shcc_pack_H_mod(data)
		local bin = "SHCC\x1f\x00\x00\x00"
		local hash = crypto.md5("SHCC\x1f\x00\x00\x00"..data:sub(17), true)

		bin ..= "\x00"
		bin ..= string.pack("<I4I4", #data, #data)
		bin ..= hash
		bin ..= data:sub(17)

		bin ..= "\x00\xFF\xFF\xFF\xFF\x00\x00\x00\x00\x00\xFF\xFF\xFF\xFF\x00\x00\x00\x00\x52"
		bin ..= string.pack("<I4", crypto.crc32c(bin))

		return bin, hash
	end

	io.mkdirs("OpenWF/content/0")
	if compressed, decompressed_size := owf_cache_find("H.Misc", "/H.Cache.bin") then
		if compressed:byte(1) == 0x80 then
			io.contents("OpenWF/content/0/H.Cache.bin!D_---------------------w.bak", shcc_pack_H(compressed, decompressed_size))
		end
	end

	local any_mods = false
	io.mkdir("OpenWF/content (managed)")
	if io.isdir("OpenWF/content (managed)/0") then
		local t = os.millis()

		do
			local compressed, decompressed_size = owf_cache_find("H.Misc", "/B.Cache.Windows.bin")
			if compressed:byte(1) == 0x80 then
				io.contents("OpenWF/content/0/B.Cache.Windows.bin!D_"..b64m_encode(shcc_decompress_chunk_oodle(compressed, 1, decompressed_size):sub(1, 16)), shcc_pack_H(compressed, decompressed_size))
			end
		end

		local meta_manifest = new CacheManifest(shcc_unpack(io.contents("OpenWF/content/0/H.Cache.bin!D_---------------------w.bak")).H)
		local og_cache_manifest_hash = b64m_encode(meta_manifest:getHash("/B.Cache.Windows.bin"))
		if cont := io.contents("OpenWF/content/0/B.Cache.Windows.bin!D_"..og_cache_manifest_hash) then
			local main_manifest = new CacheManifest(shcc_unpack(cont).H)

			local paths = {}
			for io.listdir("OpenWF/content (managed)/0", true) as file do
				if io.isfile(file) then
					file = file:sub(27):replace("\\", "/")
					any_mods = true

					io.mkdirs(io.part("OpenWF/content/0"..file, "parent"))
					io.copy("OpenWF/content (managed)/0"..file, "OpenWF/content/0"..file)

					local path = file:split("!")[1]
					if hash := paths[path] then
						print_to_console("Ignoring "..file.." in favor of "..hash)
						continue
					end
					local hash = file:split("!")[2]:split("_")[2]
					paths[path] = hash
					main_manifest:setHash(path, b64m_decode(hash))

					local compressed, decompressed_size = owf_cache_find("H.Misc", path)
					local B_cache = "B.Misc"
					if not compressed then
						compressed, decompressed_size = owf_cache_find("H.Texture", path)
						B_cache = "B.Texture"
					end
					if compressed then
						if compressed:byte(1) == 0x80 then
							local B_compressed, B_decompressed_size = owf_cache_find(B_cache, path)
							io.contents("OpenWF/content/0"..path.."!"..file:split("!")[2]:split("_")[1].."_"..b64m_encode(shcc_decompress_chunk_oodle(compressed, 1, decompressed_size):sub(1, 16)), shcc_pack_HB(compressed, decompressed_size, B_compressed, B_decompressed_size))
						end
					else
						print_to_console("Could not create backup for "..path)
					end
				end
			end

			if any_mods then
				local bin, hash = shcc_pack_H_mod(main_manifest:pack())
				meta_manifest:setHash("/B.Cache.Windows.bin", hash)
				hash = b64m_encode(hash)
				io.contents("OpenWF/content/0/B.Cache.Windows.bin!D_"..hash, bin)
				io.contents("OpenWF/content/0/H.Cache.bin!D_---------------------w", (shcc_pack_H_mod(meta_manifest:pack())))

				for io.listdir("OpenWF/content/0") as path do
					local file = path:sub(18)
					if #file == 44 and file:sub(1, 22) == "B.Cache.Windows.bin!D_"
						and file:sub(23) ~= hash and file:sub(23) ~= og_cache_manifest_hash
					then
						os.remove(path)
					end
				end
			end

			print_to_console("Managed content in "..(os.millis() - t).." ms")
		else
			print_to_console("Unable to manage content: Original cache manifest not found")
		end
	end

	owf_cache_close()

	if not any_mods then
		io.copy("OpenWF/content/0/H.Cache.bin!D_---------------------w.bak", "OpenWF/content/0/H.Cache.bin!D_---------------------w")
	end
end

local requested_versions = false
local current_version = ""
local version_is_latest = nil
local current_hotfix = ""
local hotfix_available = ""
local hotfix_available_sha256 = ""
local downloading_hotfix = false

local function send_version_broadcast(recipient)
	owf_broadcast_message(json.encode{
		version_broadcast = {
			current = current_version,
			latest = version_is_latest,
			hotfix = current_hotfix,
			hotfix_available = hotfix_available,
		}
	}, recipient)
end

local function check_for_updates()
	owf_create_thread(function()
		current_version = ""
		version_is_latest = nil
		local meta
		if not OWF_PRIVATE_BUILD then
			send_version_broadcast()
			meta = http.request("https://openwf.io/supplementals/client%20drop-in/meta")
			if meta then
				meta = json.decode(meta)
			end
		end
		version_is_latest = false
		if meta and meta.manifest then
			local sha256 = crypto.sha256(io.contents("dwmapi.dll") or io.contents("wtsapi32.dll") or io.contents("version.dll"))
			local hotfix_sha256 = ""
			if hotfix_bin := io.contents("OpenWF/Hotfix.owf") then
				hotfix_sha256 = crypto.sha256(hotfix_bin)
			end
			version_is_latest = sha256 == meta.sha256
			if dll := meta.manifest:find(|x| -> x.sha256 == sha256) then
				current_version = dll.version
				hotfix_available_sha256 = dll.latest_hotfix_sha256
				if dll.latest_hotfix_sha256 ~= hotfix_sha256 then
					hotfix_available = dll.latest_hotfix
				end
				if hotfix := dll.hotfixes:find(|x| -> x.sha256 == hotfix_sha256) then
					current_hotfix = hotfix.name
				end
			end
		end
		send_version_broadcast()
	end)
end

local ivkr_available <const> = compareversions(owf_get_build_version(), "2024.12.11.14.26") >= 0

local last_status_update = 0
local last_status_string

local function send_status_broadcast(recipient)
	owf_broadcast_message(json.encode{
		bgscript_status_string = last_status_string
	}, recipient)
end

local script_log_len = 0

register_pseudo_command("freecam", function()
	if ivkr_available and not owf_tunables_has("prohibit_freecam") then
		if ply := gRegion:GetLocalPlayer() then
			ply:setControllingCamera(true)
			ply:GetAvatar():ControlCamera(false)
		end
	end
end)
register_pseudo_command("lockcam", function()
	if ivkr_available and not owf_tunables_has("prohibit_freecam") then
		if ply := gRegion:GetLocalPlayer() then
			ply:setControllingCamera(false)
			ply:GetAvatar():ControlCamera(false)
		end
	end
end)
register_pseudo_command("gamecam", function()
	if ivkr_available and not owf_tunables_has("prohibit_freecam") then
		if ply := gRegion:GetLocalPlayer() then
			ply:setControllingCamera(false)
			ply:GetAvatar():ControlCamera(true)
		end
	end
end)
register_pseudo_command("teleport", function(_, pos)
	if ivkr_available and not owf_tunables_has("prohibit_teleport") then
		local arr = pos:split(",")
		if #arr == 3 then
			gRegion:GetLocalPlayerAvatar():SetPosition(Vector(tonumber(arr[1]), tonumber(arr[2]), tonumber(arr[3])))
		end
	end
end)
register_pseudo_command("enable_pause_always_stops_time", function()
	set_pause_always_stops_time(true)
	owf_broadcast_message[[{"pause_always_stops_time":true}]]
end)
register_pseudo_command("disable_pause_always_stops_time", function()
	gGameRules:RequestUnpause()
	set_pause_always_stops_time(false)
	owf_broadcast_message[[{"pause_always_stops_time":false}]]
end)
register_pseudo_command("request_bgscript_broadcasts", function(sender)
	if last_status_string then
		send_status_broadcast(sender)
	end
	if not requested_versions then
		requested_versions = true
		check_for_updates()
	else
		send_version_broadcast(sender)
	end
end)
register_pseudo_command("download_latest_hotfix", function()
	if not downloading_hotfix then
		downloading_hotfix = true
		owf_create_thread(function()
			if bin := http.request($"https://openwf.io/supplementals/client%20drop-in/{current_version}/{hotfix_available}/Hotfix.owf") then
				if crypto.sha256(bin) == hotfix_available_sha256 then
					io.contents("OpenWF/Hotfix.owf", bin)
					http.request("http://localhost:6155/apply_hotfix")
					current_hotfix = hotfix_available
					hotfix_available = ""
					hotfix_available_sha256 = ""
					owf_broadcast_message[[{"reload":1}]]
				else
					print("Downloaded hotfix but checksum mismatches. Discarding it.")
				end
			else
				print("Failed to download hotfix.")
			end
			downloading_hotfix = false
		end)
	end
end)
register_pseudo_command("check_for_updates", function()
	check_for_updates()
end)

while pcall(yield) do
	if os.millis() - last_status_update >= 20 then
		local status = {
			camtype = "gamecam",
			pos = "",
			markers = {}
		}
		if ivkr_available then
			if ply := gRegion:GetLocalPlayer() then
				if avatar := ply:GetAvatar() then
					if not avatar:isFollowedByCamera() then
						status.camtype = gRegion:GetLocalPlayer():isControllingCamera() ? "freecam" : "lockcam"
					end
					local pos = avatar:GetPosition()
					status.pos = "%f,%f,%f":format(pos.x, pos.y, pos.z)
				end
				if hud := ply:GetHudStatus() then
					for hud:GetFlashMarkers() as marker do
						if not marker.garbage then
							local pos = marker.baseMarkerInfo:GetPosition()
							status.markers:insert({
								type = marker.markerType,
								x = pos.x,
								y = pos.y,
								z = pos.z,
								dist = marker.distanceToEye,
							})
						end
					end
				end
			end
		end
		local status_string = json.encode(status)
		if status_string ~= last_status_string then
			last_status_string = status_string
			send_status_broadcast()
		end
		if (script_log_nlen := owf_get_script_log_len()) ~= script_log_len then
			if script_log_nlen > script_log_len then
				owf_broadcast_message(json.encode({
					script_log_olen = script_log_len,
					script_log_nlen = script_log_nlen,
					script_log_app = owf_get_script_log_sub(script_log_len),
				}))
			end
			script_log_len = script_log_nlen
		end
		last_status_update = os.millis()
	end
	if (fov_override := get_fov_override()) ~= 0 then
		if ivkr_available and not owf_tunables_has("prohibit_fov_override") then
			if ply := gRegion:GetLocalPlayer() then
				ply:CameraControl():SetBaseFovOverride(fov_override)
			end
		end
	end
	while evt := owf_next_event() do
		if evt.type ~= OWF_EVT_CUSTOM_ROUTE_SERVED or evt.path ~= "/favicon.ico" then
			print("Unhandled event in background script: "..dumpvar(evt))
		end
	end
end