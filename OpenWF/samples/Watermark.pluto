-- Modifications to sample scripts will be lost the next time you start the game.
owf_overlay_add_text(10 + 2, 10 + 2, "OpenWF", OWF_FONT_SIMPLE8, 0, 0, 0, 2) -- shadow
owf_overlay_add_text(10, 10, "OpenWF", OWF_FONT_SIMPLE8, 90, 253, 123, 2) -- text
$if false then -- optionally, also display the server host
	owf_overlay_add_text(88 + 1, 18 + 1, "@ " .. owf_get_server_host(), OWF_FONT_SIMPLE8, 0, 0, 0, 1) -- shadow
	owf_overlay_add_text(88, 18, "@ " .. owf_get_server_host(), OWF_FONT_SIMPLE8, 90, 253, 123, 1) -- text
$end
owf_overlay_update()
while pcall(yield) do end -- keep the script running