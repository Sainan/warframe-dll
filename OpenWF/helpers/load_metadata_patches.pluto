function parse_metadata_patches(str, filename)
	local patches = {}
	local patch = { keys = {}, prefix = "", replacements = {}, substitutions = {} }
	local ampersand = false
	local function delimit_patch()
		if #patch.keys ~= 0 then
			patches:insert(patch)
		end
		patch = { keys = {}, prefix = "", replacements = {}, substitutions = {} }
	end
	for linenum, line in str:split("\n") do
		if line[1] == "/" then
			if ampersand then
				ampersand = false
			else
				delimit_patch()
				print_to_console("[Metadata Patches] Starting a patch via / is deprecated.")
				print_to_console("[Metadata Patches] - Note: If this was intentional, prefix a right angle bracket (>). Otherwise, use indentation.")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
				print_to_console("[Metadata Patches] - What: "..line)
			end
			line = line:strip()
			if line[-1] == "&" then
				ampersand = true
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
			continue
		end
		line = line:strip()
		ampersand = false
		if line[1] == "&" then
			ampersand = true
			line = line:sub(2):strip()
			if line[-1] == "&" then
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
		elseif line[1] == ">" then
			delimit_patch()
			line = line:sub(2):strip()
			if line[-1] == "&" then
				ampersand = true
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
		elseif line:sub(1, 2) == "r|" then
			if sep := line:find("|", 3) then
				patch.replacements[line:sub(3, sep - 1)] = line:sub(sep + 1):rstrip("|")
			else
				print_to_console("[Metadata Patches] Ignoring malformed line")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
				print_to_console("[Metadata Patches] - What: "..line)
			end
		elseif line:sub(1, 2) == "s|" then
			if sep := line:find("|", 3) then
				patch.substitutions[line:sub(3, sep - 1)] = line:sub(sep + 1):rstrip("|")
			else
				print_to_console("[Metadata Patches] Ignoring malformed line")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
				print_to_console("[Metadata Patches] - What: "..line)
			end
		elseif #line ~= 0 and line[1] ~= "#" then
			patch.prefix = patch.prefix .. line .. "\n"
		end
	end
	if #patch.keys ~= 0 then
		patches:insert(patch)
	end
	return patches
end

function load_metadata_patches(str, filename)
	for parse_metadata_patches(str, filename) as patch do
		for patch.keys as key do
			if key[1] ~= "/" then
				print_to_console("[Metadata Patches] Can't patch invalid path: "..key)
				continue
			end
			new_patch(key, patch.prefix)
			for k, v in patch.replacements do
				add_replacement(k, v)
			end
			for k, v in patch.substitutions do
				add_substitution(k, v)
			end
		end
	end
end

if io.exists("OpenWF/Metadata Patches/") then
	for io.listdir("OpenWF/Metadata Patches/") as path do
		if path:sub(-4) == ".txt" then
			if str := io.contents(path) then
				load_metadata_patches(str, io.relative(path))
			end
		end
	end
end
