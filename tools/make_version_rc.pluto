local code_version = io.contents("main.cpp"):split("\n")[1]:sub(29 + #"OpenWF Bootstrapper v", -3)

io.contents("version.rc", [[#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ]]..code_version:replace(".", ",").."\n"..[[
 PRODUCTVERSION ]]..code_version:replace(".", ",").."\n"..[[
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "OpenWF Bootstrapper\0"
            VALUE "FileVersion", "]]..code_version..[[\0"
            VALUE "ProductName", "OpenWF Bootstrapper\0"
            VALUE "ProductVersion", "]]..code_version..[[\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
]])
