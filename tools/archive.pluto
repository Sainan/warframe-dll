local { crypto, json } = require "*"
assert(json.encode({ 0, true, json.null }, "msgpack") == "\x93\x00\xc3\xc0")

require "u64_dyn"
require "vv"

io.chdir("..")

-- Do a translation update so all target dicts have all source strings
os.execute("cd modules/openwf-translations && php update.php")

local uncompressed = ""

local function add_file_to_archive(path, archive_path)
	io.write(path.." -> "..archive_path)
	local cont = io.contents(path)
	if path == "OpenWF/runtime.pluto" then
		io.write(" [compiled]")
		assert(os.execute("tools\\plutoc "..path))
		cont = io.contents("plutoc.out")
		io.remove("plutoc.out")
	elseif path:sub(-5) == ".json" and path ~= "OpenWF/Hotkeys.json" then
		io.write(" [minified]")
		cont = json.decode(cont, json.withorder | json.withnull)
		if path == "OpenWF/tunables.json" then
			assert(json.encode({ 0, true, json.null }, "msgpack") == "\x93\x00\xc3\xc0")
			local packed = { __order = {} }
			for cont.__order as k do
				local v = cont[k]
				k = crypto.joaat(k)
				packed.__order:insert(k)
				if type(v) == "table" then
					packed[k] = v:mapped(crypto.joaat)
				else
					packed[k] = v
				end
			end
			cont = json.encode(packed, "msgpack")
			--print(cont:split(""):map(|x| -> string.format("%02x ", x:byte())):concat())
		elseif path:sub(1, 10) == "OpenWF/vv/" then
			local arr = {}
			for cont.__order as ver do
				local val = cont[ver]
				if val:sub(1, 2) == "0x" then
					val = tonumber(val:sub(3), 16)
				else
					val = vv_v2n(val)
				end
				arr:insert({ vv_v2n(ver), val })
			end
			cont = vv_enc_int(arr)
		else
			cont = json.encode(cont)
		end
	end
	if cont == "" then
		io.write(" [empty, skipping]\n")
		return
	end
	io.write("\n")
	uncompressed ..= "I4s4":pack(crypto.joaat(archive_path), cont)
end

local function add_folder_to_archive(base, archive_base)
	for io.listdir(base) as path do
		if io.isfile(path) then
			local archive_path = archive_base..io.part(path, "name")
			add_file_to_archive(path, archive_path)
		end
	end
end

add_folder_to_archive("OpenWF/", "OpenWF/")
add_folder_to_archive("OpenWF/helpers/", "OpenWF/helpers/")
add_folder_to_archive("OpenWF/lib/", "OpenWF/lib/")
add_folder_to_archive("OpenWF/samples/", "OpenWF/samples/")
add_folder_to_archive("OpenWF/vv/", "OpenWF/vv/")
add_folder_to_archive("modules/openwf-translations/bootstrapper-core/", "OpenWF/translations/core/")
add_folder_to_archive("modules/openwf-translations/bootstrapper-webui/", "OpenWF/translations/webui/")

io.contents("archive.tmp", uncompressed)
