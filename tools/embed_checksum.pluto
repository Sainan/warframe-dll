local crypto = require "crypto"

local dll = io.contents("dwmapi.dll")
local to_hash = dll:replace("\x6D\xF7\xA9\x52\x20\x76\x2E\x5F\xF9\x75\x01\xAA\x67\x37\x7F\xCA\x3C\x1B\x2C\xA0\x24\x73\xFB\xEA\xF4\xBD\xEF\x8B\x43\xDF\x1E\xAE", "")
assert(#to_hash == #dll - 0x20)
local dll_sha256 = crypto.sha256(to_hash, true)
io.contents(
	"dwmapi.dll",
	dll:replace(
		"\x6D\xF7\xA9\x52\x20\x76\x2E\x5F\xF9\x75\x01\xAA\x67\x37\x7F\xCA\x3C\x1B\x2C\xA0\x24\x73\xFB\xEA\xF4\xBD\xEF\x8B\x43\xDF\x1E\xAE",
		dll_sha256
	)
)
