if arg[1] and arg[2] then
	local { crypto, json } = require "*"
	local data = arg[1] |> io.contents |> json.decode|json.withorder + json.withnull|
	if arg[1] == "OpenWF/tunables.json" then
		assert(json.encode({ 0, true, json.null }, "msgpack") == "\x93\x00\xc3\xc0")
		local packed = { __order = {} }
		for data.__order as k do
			local v = data[k]
			k = crypto.joaat(k)
			packed.__order:insert(k)
			if type(v) == "table" then
				packed[k] = v:mapped(crypto.joaat)
			else
				packed[k] = v
			end
		end
		data = json.encode(packed, "msgpack")
		--print(data:split(""):map(|x| -> string.format("%02x ", x:byte())):concat())
	elseif arg[1]:sub(1, 10) == "OpenWF/vv/" then
		require "u64_dyn"

		-- Converts a version string (of uniform length) to an integer representation, e.g. "24.12.0" becomes 24120.
		function vv_v2n(ver)
			local n = 0
			for i = 1, #ver do
				local b = ver:byte(i)
				if b >= 48 and b < 58 then
					n = n * 10
					n = n + (b - 48)
				end
			end
			return n
		end

		function vv_enc_int(arr)
			local out = ""
			for _, e in ipairs(arr) do
				out = out .. pack_u64_dyn_v2(e[1]) .. pack_u64_dyn_v2(e[2])
			end
			return out
		end

		--[[function vv_dec_int(str, ver)
			local i = 1
			local v
			while i < #str do
				v, i = unpack_u64_dyn_v2(str, i)
				if ver >= v then
					v, i = unpack_u64_dyn_v2(str, i)
					return v
				end
				v, i = unpack_u64_dyn_v2(str, i)
			end
			return 0
		end]]

		local arr = {}
		for data.__order as buildLabel do
			arr:insert({ vv_v2n(buildLabel), vv_v2n(data[buildLabel]) })
		end
		data = vv_enc_int(arr)
	else
		data = json.encode(data)
	end
	io.contents(arg[2], data)
else
	print("Syntax: pluto json_minify.pluto <in file> <out file>")
end
